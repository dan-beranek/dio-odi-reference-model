  arc:sourceSection "§5.3; §5.4" ;
  arc:interpretationNote "The set is claim-specific and records evidence roles; membership alone is not sufficient without proposition-specific support." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R040> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:Architecture ;
