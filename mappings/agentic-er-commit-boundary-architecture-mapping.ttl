  arc:sourceSection "§5.3; Algorithm 2" ;
  arc:interpretationNote "Only an item passing the admission gate is admitted to P_active as UNVERIFIED." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R027> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ActiveEvidenceSet ;
  rdf:predicate arc:hasStatus ;
  rdf:object arc:UnverifiedStatus ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3" ;
  arc:interpretationNote "Admission to P_active confers UNVERIFIED status and no positive authorization support." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R028> a rdf:Statement, arc:RelationAssertion ;
