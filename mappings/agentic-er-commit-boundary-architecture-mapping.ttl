  arc:sourceSection "§6.3; Algorithm 2" ;
  arc:interpretationNote "The required claim set is re-derived and compared with the set bound in α_m." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R045> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:Phase2Validation ;
  rdf:predicate arc:usesSnapshot ;
