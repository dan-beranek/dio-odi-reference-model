  arc:interpretationNote "The candidate graph is assessed against the applicable domain-configured constraints." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R048> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:Phase2Validation ;
  rdf:predicate arc:checksPropositionCoverageFrom ;
