  arc:sourceSection "§5.4; §6.1; §6.3" ;
  arc:interpretationNote "Graph, evidence, policy, and optional shadow versions must remain valid atomically at the commit point." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

