  arc:sourceSection "§6.3; Algorithm 2" ;
  arc:interpretationNote "Phase 2 validates the realized candidate before persistent commit." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R043> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:Phase2Validation ;
  rdf:predicate arc:evaluates ;
