  arc:sourceSection "§5.3; §5.4" ;
  arc:interpretationNote "An unresolved indication prevents PASS until resolved under policy." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R039> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:AuthorizationEligibleEvidenceSet ;
  rdf:predicate arc:supportsAssessmentOf ;
  rdf:object arc:RequiredPropositionSet ;
