  arc:sourceSection "§5.3" ;
  arc:interpretationNote "Promotion grants eligibility only for the assessed proposition, role, context, and applicability." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R036> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:AuthorizationEligibleEvidenceSet ;
  rdf:predicate arc:hasPossibleRole ;
