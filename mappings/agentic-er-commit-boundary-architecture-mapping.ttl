  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.4" ;
  arc:interpretationNote "Valid bound versions at the same commit snapshot are a conjunctive requirement." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R055> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:OutcomeBREACH ;
