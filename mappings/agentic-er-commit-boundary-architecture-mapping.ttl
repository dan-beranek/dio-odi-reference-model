  arc:sourceSection "§5.3; §6" ;
  arc:interpretationNote "The Planner may use active UNVERIFIED material for provisional reasoning." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R029> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ActiveEvidenceSet ;
  rdf:predicate arc:notSufficientByItselfFor ;
  rdf:object arc:RequiredPropositionSet ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3" ;
  arc:interpretationNote "Planner-visible UNVERIFIED evidence cannot satisfy a required positive authorization proposition." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R030> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ActiveEvidenceSet ;
  rdf:predicate arc:mayIndicate ;
  rdf:object arc:UnresolvedIndicationRole ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3" ;
  arc:interpretationNote "UNVERIFIED material may indicate an unresolved conflict and cause deferral, but it cannot itself establish a mutation-level BREACH or positive support." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R031> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ClaimSpecificPromotion ;
  rdf:predicate arc:evaluates ;
