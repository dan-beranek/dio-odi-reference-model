  arc:sourceSection "§6.1; §6.2" ;
  arc:interpretationNote "Relevant graph, evidence, policy, and optional shadow versions are bound to authorization and rechecked at commit." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R024> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:EvidenceObservation ;
  rdf:predicate arc:initiallyEnters ;
  rdf:object arc:QuarantineEvidence ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; Algorithm 2" ;
  arc:interpretationNote "Retrieved observations first enter quarantine before any Planner-visible admission." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R025> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:AdmissionConflictCheck ;
  rdf:predicate arc:controlsAdmissionFrom ;
  rdf:object arc:QuarantineEvidence ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; Algorithm 2" ;
  arc:interpretationNote "A conflict or indeterminate result retains the item in quarantine; no detected conflict is not positive support." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R026> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:AdmissionConflictCheck ;
  rdf:predicate arc:mayAdmitAsUnverified ;
  rdf:object arc:ActiveEvidenceSet ;
