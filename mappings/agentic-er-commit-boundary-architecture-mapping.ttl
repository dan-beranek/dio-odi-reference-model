  arc:sourceSection "§5.4; Algorithm 1" ;
  arc:interpretationNote "The Supervisor derives q_m from the proposed operation, target/effect scope, configured constraint set V_E, and versioned policy v_pol; the separate relations record each input." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R021> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:RequiredPropositionSet ;
  rdf:predicate arc:boundIn ;
  rdf:object arc:AuthorizationRecord ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.4; §6.2" ;
  arc:interpretationNote "The derived proposition set is bound in α_m and cannot be replaced or weakened by the Planner." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R022> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:AuthorizationRecord ;
  rdf:predicate arc:binds ;
  rdf:object arc:ProposedMutation ;
