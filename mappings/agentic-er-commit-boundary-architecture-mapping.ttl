  arc:sourceSection "§5.4; §6.3" ;
  arc:interpretationNote "Each required proposition must have claim-specific support with an applicable recorded validation basis." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R049> a rdf:Statement, arc:RelationAssertion ;
