  arc:sourceSection "§5.3; §5.4" ;
  arc:interpretationNote "Only support-role evidence can satisfy a required positive proposition." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R037> a rdf:Statement, arc:RelationAssertion ;
