  arc:sourceSection "§6.1; §6.2" ;
  arc:interpretationNote "The authorization record is specific to the proposed action and its target/effect scope." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R023> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:AuthorizationRecord ;
  rdf:predicate arc:bindsVersionContext ;
  rdf:object arc:CommitSnapshot ;
