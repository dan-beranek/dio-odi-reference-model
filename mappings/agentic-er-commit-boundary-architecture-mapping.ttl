  arc:sourceSection "§5.3; §5.4" ;
  arc:interpretationNote "A claim-specific contradiction may establish a prohibitive condition or BREACH." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R038> a rdf:Statement, arc:RelationAssertion ;
