  arc:sourceSection "§6.1; §5.4" ;
  arc:interpretationNote "Protected graph mutations bind v_G and revalidate it atomically at commit." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R099> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:AuthorizationRecord ;
  rdf:predicate arc:bindsVersion ;
  rdf:object arc:EvidenceStateVersion ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; §5.4" ;
  arc:interpretationNote "One v_E covers active/quarantined evidence and authorization-eligibility changes, including intake and promotion/demotion/revocation." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R100> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:AuthorizationRecord ;
  rdf:predicate arc:bindsVersion ;
  rdf:object arc:PolicyVersion ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; §5.4" ;
  arc:interpretationNote "The relevant domain-policy version v_pol is bound and checked at authorization and commit." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R101> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:AuthorizationRecord ;
  rdf:predicate arc:conditionallyBindsVersion ;
  rdf:object arc:ShadowVersion ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; §5.4" ;
  arc:interpretationNote "The shadow version v_S is bound when a shadow layer is used and relevant to the action." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R102> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:DomainPolicy ;
  rdf:predicate arc:fixes ;
  rdf:object arc:ObservationContext ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.1; §5.4" ;
  arc:interpretationNote "The context ω in P_auth(q_m,ω) is fixed by the policy instance bound through v_pol, not a free runtime variable." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R103> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:AuthorizationRecord ;
  rdf:predicate arc:bindsEvidenceRecordForEachClaim ;
  rdf:object arc:PromotionValidationRecord ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.4; Algorithm 1" ;
  arc:interpretationNote "For every required proposition, α_m identifies the promotion/validation record relied on for its claim-specific support." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R104> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:Phase2Validation ;
  rdf:predicate arc:rechecksBoundEvidenceRecordsAgainst ;
  rdf:object arc:CommitSnapshot ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.4; Algorithm 2" ;
  arc:interpretationNote "Phase 2 verifies that each referenced support record remains present and applicable in the same σ_c snapshot." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R105> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ClaimSpecificPromotion ;
  rdf:predicate arc:appliesRestriction ;
  rdf:object arc:SharedOriginIndependenceRule ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3" ;
  arc:interpretationNote "Recorded shared upstream query, hypothesis, source, or derivation paths do not count as independent corroboration merely because observations are separate items." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R106> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ClaimSpecificPromotion ;
  rdf:predicate arc:appliesRestriction ;
  rdf:object arc:ShadowLineageExclusionRule ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3" ;
  arc:interpretationNote "Promotion excludes shadow candidates and recorded claim bases that transitively cite shadow content." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R107> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:AdmissionConflictCheck ;
  rdf:predicate arc:mayReturn ;
  rdf:object arc:AdmissionConflict ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; Algorithm 2" ;
  arc:interpretationNote "A supported material conflict retains the observation in quarantine." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R108> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:AdmissionConflictCheck ;
  rdf:predicate arc:mayReturn ;
  rdf:object arc:AdmissionNoConflictDetected ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; Algorithm 2" ;
  arc:interpretationNote "No conflict detected means only that this check did not establish a conflict; it is not identity support or proof that no conflict exists." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R109> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:AdmissionConflictCheck ;
  rdf:predicate arc:mayReturn ;
  rdf:object arc:AdmissionIndeterminate ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; Algorithm 2" ;
  arc:interpretationNote "An unresolved or plausible conflict retains the observation in quarantine." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R110> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:StatusPrecedenceRule ;
  rdf:predicate arc:prioritizes ;
  rdf:object arc:OutcomeBREACH ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3" ;
  arc:interpretationNote "BREACH has highest priority and blocks PASS even if other required conditions are unknown." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R111> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:StatusPrecedenceRule ;
  rdf:predicate arc:thenPrioritizes ;
  rdf:object arc:OutcomeUNKNOWN ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3" ;
  arc:interpretationNote "UNKNOWN_EVIDENCE takes precedence over PASS when no established BREACH is present." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R112> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:StatusPrecedenceRule ;
  rdf:predicate arc:lowestPriority ;
  rdf:object arc:OutcomePASS ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3" ;
  arc:interpretationNote "PASS is available only when no BREACH or UNKNOWN_EVIDENCE condition applies." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R113> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:OutcomeUNKNOWN ;
  rdf:predicate arc:mayEnterConditionalBranch ;
  rdf:object arc:HumanAdjudicationBranch ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "Algorithm 1 step 9; Algorithm 2 step 11; §6.3" ;
  arc:interpretationNote "HITL is returned only when policy requires human review and a reviewer is available; otherwise the result is DEFER_UNRESOLVED." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R114> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:HumanAdjudicationBranch ;
  rdf:predicate arc:requiresNewDecision ;
  rdf:object arc:FreshAuthorizationDecision ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; §6.3" ;
  arc:interpretationNote "Any human adjudication that changes disposition requires a new authorization decision against current versions; it cannot revive stale authority." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R115> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:FreshAuthorizationDecision ;
  rdf:predicate arc:uses ;
  rdf:object arc:CommitSnapshot ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; §6.3" ;
  arc:interpretationNote "The new decision is evaluated against current relevant graph, evidence, eligibility, policy, and shadow state versions." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R116> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:CommonRetryBudget ;
  rdf:predicate arc:appliesAcross ;
  rdf:object arc:Phase1Authorization ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 1" ;
  arc:interpretationNote "The retry budget is shared across retry triggers rather than independently reset by each phase." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R117> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:CommonRetryBudget ;
  rdf:predicate arc:appliesAcross ;
  rdf:object arc:Phase2Validation ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 2 step 13" ;
  arc:interpretationNote "The same retry budget covers version/snapshot conflicts, shadow version changes, and evidence admission compare-and-swap retries." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R118> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:DomainConfiguredConstraints ;
  rdf:predicate arc:scopedBy ;
  rdf:object arc:ObservationContext ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.2; §5.4" ;
  arc:interpretationNote "Configured constraints are scoped to the observation context fixed by the applicable policy." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R119> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:DomainConfiguredConstraints ;
  rdf:predicate arc:scopedBy ;
  rdf:object arc:TemporalApplicability ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.2; §5.3" ;
  arc:interpretationNote "Temporal applicability is an explicit scope dimension where continuity or state claims depend on a validity interval." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R120> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ProposedMutation ;
  rdf:predicate arc:hasClass ;
  rdf:object arc:CorrectiveIdentityMutation ;
