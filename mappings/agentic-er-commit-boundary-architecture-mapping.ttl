  arc:sourceSection "§8.1" ;
  arc:interpretationNote "Outcome adjudicators are independent of policy authors and masked to condition where practicable." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R152> a rdf:Statement, arc:RelationAssertion ;
