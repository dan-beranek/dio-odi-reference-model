  arc:sourceSection "§5.4; §6.1" ;
  arc:interpretationNote "Splits and corrective un-merges are protected when they can alter shared identity interpretation; each has policy-defined required propositions." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R121> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:CorrectiveIdentityMutation ;
  rdf:predicate arc:derivesRequirementsThrough ;
  rdf:object arc:DomainPolicy ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.4" ;
  arc:interpretationNote "Corrective operations do not inherit authorization from the earlier merge; the versioned domain policy defines their own q_m." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R122> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:EvaluationProtocol ;
  rdf:predicate arc:usesCommonReference ;
  rdf:object arc:CommonEvaluationReference ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/proposed-evaluation> ;
  arc:sourceSection "§8.1; §8.2" ;
  arc:interpretationNote "SRC, UAR, and FPIR use a condition-independent evaluation reference rather than either condition's authored policy." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R123> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:OutcomeAdjudicators ;
  rdf:predicate arc:apply ;
  rdf:object arc:CommonEvaluationReference ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/proposed-evaluation> ;
  arc:sourceSection "§8.1" ;
  arc:interpretationNote "Outcome adjudicators are independent of policy authors and masked to condition where practicable." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R124> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:IndependentCaseConstruction ;
  rdf:predicate arc:constructsOrReviews ;
  rdf:object arc:CaseInventory ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/proposed-evaluation> ;
  arc:sourceSection "§8.1" ;
  arc:interpretationNote "The case inventory and strata are constructed or independently reviewed without access to frozen condition policies." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R125> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:EvaluationProtocol ;
  rdf:predicate arc:includesStratum ;
  rdf:object arc:TaxonomyNeutralStratum ;
