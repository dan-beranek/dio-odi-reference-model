  arc:sourceSection "§5.3" ;
  arc:interpretationNote "Promotion evaluates the specific proposition, source/provenance basis, evidentiary role, applicability, validation basis, and policy version." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R032> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ClaimSpecificPromotion ;
  rdf:predicate arc:isScopedBy ;
  rdf:object dio:ObservationDomain ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3" ;
  arc:interpretationNote "Evidence eligibility is bound to observation context and relevant temporal applicability." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R033> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ClaimSpecificPromotion ;
  rdf:predicate arc:assesses ;
  rdf:object arc:RequiredPropositionSet ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3" ;
  arc:interpretationNote "Promotion is proposition-specific and cannot be inferred from document relevance, query match, or Planner confidence alone." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R034> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ClaimSpecificPromotion ;
  rdf:predicate arc:requiresSoundExecutionUnder ;
  rdf:object arc:DomainPolicy ;
