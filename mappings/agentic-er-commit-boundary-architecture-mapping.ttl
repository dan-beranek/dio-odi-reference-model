arc:IsolationState a rdfs:Class ; rdfs:label "isolation state"@en ; rdfs:comment "A separately represented state used to establish and revalidate staging isolation."@en .
arc:ClaimConflictOutcome a rdfs:Class ; rdfs:label "claim conflict outcome"@en ; rdfs:comment "A result of the mutation-specific CheckClaimConflict function, distinct from evidence-admission outcomes."@en .
arc:ArchitectureComponent a rdfs:Class ; rdfs:label "architecture component"@en ; rdfs:comment "A locally defined component of the proposed Agentic ER commit-boundary architecture."@en .
arc:RelationAssertion a rdfs:Class ; rdfs:label "qualified relation assertion"@en ; rdfs:comment "A relation qualified with source section, interpretation note, and epistemic status."@en .
arc:EpistemicStatus a rdfs:Class ; rdfs:label "epistemic status"@en ; rdfs:comment "A status distinguishing specified, assumed, illustrative, prospective, and future-research relations."@en .
arc:Assumption a rdfs:Class ; rdfs:label "assumption"@en ; rdfs:comment "A precondition of the conditional commit property."@en .
arc:epistemicStatus a rdf:Property ; rdfs:label "epistemic status"@en ; rdfs:comment "The status of the qualified relation assertion."@en .
arc:sourceSection a rdf:Property ; rdfs:label "source section"@en ; rdfs:comment "The section or algorithm in the source paper grounding the relation."@en .
arc:interpretationNote a rdf:Property ; rdfs:label "interpretation note"@en ; rdfs:comment "An authored qualification of the relation semantics."@en .
arc:informedBy a rdf:Property ; rdfs:label "informed by"@en ; rdfs:comment "A conceptual or diagnostic source informs the architecture."@en .
arc:mapsSelectedDistinctionsFrom a rdf:Property ; rdfs:label "maps selected distinctions from"@en ; rdfs:comment "The binding function takes selected diagnostic distinctions as inputs."@en .
arc:producesOrInforms a rdf:Property ; rdfs:label "produces or informs"@en ; rdfs:comment "The binding step produces or informs a domain-configured constraint set."@en .
arc:boundIn a rdf:Property ; rdfs:label "bound in"@en ; rdfs:comment "A derived proposition set is bound in an authorization record."@en .
arc:visibleTo a rdf:Property ; rdfs:label "visible to"@en ; rdfs:comment "An evidence set is available to a component for reasoning."@en .
arc:producesEligibilityFor a rdf:Property ; rdfs:label "produces eligibility for"@en ; rdfs:comment "Promotion grants eligibility only for a particular claim, role, and context."@en .
arc:guards a rdf:Property ; rdfs:label "guards"@en ; rdfs:comment "An invariant constrains admission to a protected persistence boundary."@en .
arc:conditionalOn a rdf:Property ; rdfs:label "conditional on"@en ; rdfs:comment "A stated guarantee depends on explicit assumptions."@en .
arc:complementaryTo a rdf:Property ; rdfs:label "complementary to"@en ; rdfs:comment "A separate derived mapping covers a complementary analytical layer."@en .
arc:sourceManuscriptVersion a rdf:Property ; rdfs:label "source manuscript version"@en ; rdfs:comment "The working manuscript version used for section-level alignment."@en .
arc:publicSourceVersion a rdf:Property ; rdfs:label "public source version"@en ; rdfs:comment "The separately identified public preprint version."@en .
