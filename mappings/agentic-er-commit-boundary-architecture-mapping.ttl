arc:Architecture a arc:Architecture ; schema:name "DIO/ODI-informed Agentic ER commit-boundary architecture"@en ; schema:description "The proposed conceptual architecture connecting diagnostics, domain constraints, evidence eligibility, two-phase authorization, and protected commit."@en .
arc:AgenticERContext a arc:Context ; schema:name "Agentic Entity Resolution context"@en ; schema:description "An iterative ER setting in which an agent plans actions, acquires evidence, updates hypotheses, and proposes identity-changing graph mutations."@en .
arc:Planner a arc:Component ; schema:name "Agentic ER Planner"@en ; schema:description "The component that maintains provisional hypotheses, reasons over Planner-visible evidence, and proposes operations."@en .
arc:ApparentVerification a arc:AnalyticalConstruct ; schema:name "Apparent verification"@en ; schema:description "A possible feedback-path effect in which hypothesis-conditioned retrieval yields observations that appear to confirm a hypothesis without independently establishing the intended referent."@en .
arc:HypothesisConditionedRetrieval a arc:Process ; schema:name "Hypothesis-conditioned retrieval"@en ; schema:description "Evidence acquisition whose query or selection is influenced by an earlier identity hypothesis."@en .
arc:ConstraintBindingFunction a arc:ArchitectureComponent ; schema:name "Domain-governed constraint-binding function μΩ"@en ; schema:description "A partial design-time mapping from selected DIO/ODI diagnostic distinctions to explicit domain-configured identity-preserving constraints; not automatic SKOS entailment."@en .
arc:DomainPolicy a arc:Policy ; schema:name "Versioned domain policy"@en ; schema:description "A versioned policy configuring applicable identity-preserving constraints, required propositions, observation context, temporal conditions, and mutation scope."@en .
arc:DomainConfiguredConstraints a arc:ConstraintSet ; schema:name "Domain-configured identity-preserving constraints V_E"@en ; schema:description "The configured conditions evaluated for a declared entity class, observation context, temporal scope where relevant, and mutation class."@en .
arc:ExampleReferentCoreferenceConstraint a arc:IllustrativeConstraint ; schema:name "Illustrative referent co-reference requirement"@en ; schema:description "An example domain constraint: lexical similarity or a shared commercial neighborhood does not by itself establish that two records denote the same referent."@en .
arc:ExampleTemporalApplicabilityConstraint a arc:IllustrativeConstraint ; schema:name "Illustrative temporal-applicability requirement"@en ; schema:description "An example domain constraint: a rename or continuity claim must apply to the relevant referent and validity interval."@en .
arc:ExampleMaterialConflictRetentionConstraint a arc:IllustrativeConstraint ; schema:name "Illustrative material-conflict retention requirement"@en ; schema:description "An example domain constraint: materially incompatible identity-related claims remain a conflict until reconciled; clustering alone does not reconcile them."@en .
arc:ExampleContextualRelationAdequacyConstraint a arc:IllustrativeConstraint ; schema:name "Illustrative context-sensitive relation-adequacy requirement"@en ; schema:description "An example domain constraint: a relation such as brand_of may be adequate in a brand catalogue but insufficient for a legal-entity identity proposition in a compliance context."@en .
arc:ExampleContinuitySupportConstraint a arc:IllustrativeConstraint ; schema:name "Illustrative continuity-support requirement"@en ; schema:description "An example domain constraint: documented, temporally applicable evidence may establish that distinct records refer to one continuing entity."@en .
arc:OperationClass a rdfs:Class ; rdfs:label "action and operation class"@en ; rdfs:comment "A distinct abstract action/operation class used by the Agentic ER interface to select authorization, version-binding, and post-execution validation requirements."@en .
arc:MutationClass a arc:OperationClass ; schema:name "Protected identity-changing mutation class"@en ; schema:description "The operation/effect class for proposed actions whose realized or potential shared effects can alter identity interpretation and whose required propositions must be derived by the Supervisor."@en .
arc:ProposedMutation a arc:Operation ; schema:name "Proposed mutation m"@en ; schema:description "A proposed operation with a declared target and effect scope; potentially protected when it can alter shared identity interpretation."@en .
arc:RequiredPropositionSet a arc:ClaimSet ; schema:name "Required proposition set q_m"@en ; schema:description "The mutation-specific identity or continuity proposition set derived by the Supervisor from the mutation and applicable versioned policy."@en .
arc:AuthorizationRecord a arc:AuthorizationRecord ; schema:name "Authorization record α_m"@en ; schema:description "A record binding the derived proposition set to the proposed operation, target/effect scope, policy version, and relevant state versions."@en .
arc:EvidenceObservation a arc:EvidenceItem ; schema:name "Retrieved evidence observation"@en ; schema:description "An observation returned by a retrieval or tool action before it is admitted to a shared evidence set."@en .
arc:QuarantineEvidence a arc:EvidenceSet ; schema:name "Quarantined evidence P_quar"@en ; schema:description "Evidence retained outside the Planner-visible active set pending admission or adjudication."@en .
arc:AdmissionConflictCheck a arc:Process ; schema:name "Evidence-admission conflict check"@en ; schema:description "A mutation-independent check that can retain an observation in quarantine when a material conflict is detected or indeterminate; absence of a detected conflict is not positive support."@en .
arc:ActiveEvidenceSet a arc:EvidenceSet ; schema:name "Planner-visible active evidence P_active"@en ; schema:description "The evidence set available to the Planner; it may contain UNVERIFIED observations and can expose unresolved conflict indications, but does not itself provide positive authorization support. Claim-specific P_auth is an eligibility subset of this admitted set, not a separate physical store."@en .
arc:UnverifiedStatus a arc:EvidenceStatus ; schema:name "UNVERIFIED evidence status"@en ; schema:description "An admission-level status meaning claim-specific eligibility has not been established for the proposition under assessment; it is not a universal truth or falsity label."@en .
arc:ClaimSpecificPromotion a arc:Process ; schema:name "Claim-specific evidence promotion"@en ; schema:description "A separate, auditable assessment of an evidence item's role and eligibility for a particular proposition, observation domain, temporal applicability, and declared policy."@en .
arc:AuthorizationEligibleEvidenceSet a arc:EvidenceSet ; schema:name "Claim-specific authorization-eligible evidence P_auth(q_m, ω)"@en ; schema:description "A proposition- and context-specific eligibility subset of P_active, not a separate physical repository; recorded roles can include support, contradiction, or unresolved indication."@en .
arc:SupportRole a arc:EvidenceRole ; schema:name "Positive claim-support role"@en ; schema:description "A recorded evidentiary role that can satisfy a required positive proposition when its validation basis and applicability meet the declared policy."@en .
arc:ContradictionRole a arc:EvidenceRole ; schema:name "Claim-specific contradiction role"@en ; schema:description "A recorded evidentiary role that may establish a relevant contradiction or policy prohibition for a specific proposition."@en .
arc:UnresolvedIndicationRole a arc:EvidenceRole ; schema:name "Unresolved material-conflict indication"@en ; schema:description "A recorded role indicating a possible material conflict that remains unresolved or indeterminate and therefore prevents PASS."@en .
arc:Phase1Authorization a arc:SupervisorPhase ; schema:name "Phase 1 — pre-execution authorization"@en ; schema:description "The Supervisor's pre-execution evaluation of the proposed operation, required propositions, eligible evidence, applicable constraints, conflicts, scope, and relevant versions."@en .
arc:Phase2Validation a arc:SupervisorPhase ; schema:name "Phase 2 — post-execution candidate validation"@en ; schema:description "The Supervisor's post-execution evaluation of the isolated realized candidate graph, re-derived claims, evidence roles, conflicts, constraints, scope, and versions at a consistent snapshot."@en .
arc:CandidateGraph a arc:GraphState ; schema:name "Candidate graph G_cand"@en ; schema:description "The isolated candidate graph resulting from the proposed mutation and evaluated before it can affect persistent shared identity state."@en .
arc:CommitSnapshot a arc:Snapshot ; schema:name "Consistent commit-time snapshot σ_c"@en ; schema:description "The consistent snapshot of relevant production graph, active/quarantined evidence, eligibility state, policy, optional shadow store, and their versions."@en .
arc:ProtectedCommitBoundary a arc:EnforcementBoundary ; schema:name "Protected commit boundary"@en ; schema:description "The enforcement boundary at which a persistent identity-changing mutation is admitted only if the commit invariant, scope, and version conditions pass."@en .
arc:CommitInvariant a arc:Invariant ; schema:name "Commit invariant"@en ; schema:description "The interface invariant requiring EvaluateGraphConstraints=PASS, valid authorized scope, and valid bound versions at the commit point."@en .
arc:ScopeValidity a arc:AuthorizationCondition ; schema:name "Scope validity"@en ; schema:description "The condition that the realized operation, target, and effects remain within the authorization record's bound scope."@en .
arc:VersionValidity a arc:ConsistencyCondition ; schema:name "Version integrity"@en ; schema:description "The condition that graph, evidence, policy, and optional shadow versions remain valid through atomic commitment against the same snapshot."@en .
arc:OutcomePASS a arc:EvaluationOutcome ; schema:name "PASS"@en ; schema:description "The evaluation outcome indicating that required positive conditions have claim-specific support, no applicable prohibition is established, and conflict status is CLEAR."@en .
arc:OutcomeBREACH a arc:EvaluationOutcome ; schema:name "BREACH"@en ; schema:description "The evaluation outcome indicating an established relevant contradiction or explicit prohibitive-constraint violation; the candidate is rejected/escalated."@en .
arc:OutcomeUNKNOWN a arc:EvaluationOutcome ; schema:name "UNKNOWN_EVIDENCE"@en ; schema:description "The evaluation outcome indicating insufficient positive support or an unresolved/indeterminate material conflict; the protected mutation is deferred."@en .
arc:AssumptionsSet a arc:AssumptionSet ; schema:name "Assumptions 1–7"@en ; schema:description "Seven stated conditions with distinct roles: fail-closed outcome semantics, enforcement premises, and evidence/policy adequacy conditions."@en .
arc:Assumption1 a arc:Assumption ; schema:name "Assumption 1 — domain-policy adequacy"@en ; schema:description "V_E expresses relevant identity-preserving constraints for the entity class, context, time, and mutation type."@en .
arc:Assumption2 a arc:Assumption ; schema:name "Assumption 2 — claim-specific promotion correctness"@en ; schema:description "Evidence enters P_auth only when the promotion process correctly applies the declared claim-specific policy and contract."@en .
arc:Assumption3 a arc:Assumption ; schema:name "Assumption 3 — fail-closed authorization"@en ; schema:description "Insufficient evidence or an unresolved material conflict does not authorize an irreversible identity change."@en .
arc:Assumption4 a arc:Assumption ; schema:name "Assumption 4 — enforced and conservative mutation classification"@en ; schema:description "Every relevant production write passes through the Supervisor and any operation that may alter shared identity interpretation is treated as protected."@en .
arc:Assumption5 a arc:Assumption ; schema:name "Assumption 5 — Supervisor-derived authorization propositions"@en ; schema:description "The Supervisor derives q_m from the mutation, target/effect scope, and versioned policy; the Planner cannot replace or weaken it."@en .
arc:Assumption6 a arc:Assumption ; schema:name "Assumption 6 — scope and version integrity"@en ; schema:description "The authorized operation/scope and relevant graph, evidence, policy, and optional shadow versions remain valid through the commit point."@en .
arc:Assumption7 a arc:Assumption ; schema:name "Assumption 7 — recorded-basis and eligibility integrity"@en ; schema:description "The promotion process controls eligibility metadata and applies provenance restrictions to the recorded basis; unrecorded derivations remain outside the guarantee."@en .
arc:ConditionalGuarantee a arc:Guarantee ; schema:name "Conditional commit-boundary guarantee"@en ; schema:description "The protected commit property stated by the interface invariant, conditional on Assumptions 1–7; it is not a theorem of semantic correctness."@en .
arc:EvaluationProtocol a arc:EvaluationDesign ; schema:name "Proposed evaluation protocol"@en ; schema:description "A prospective comparative evaluation using independently constructed cases, common outcome adjudication, matched controls, an explicit decision rule, and author-team-aware uncertainty; no experimental results are claimed."@en .
arc:BaselineA a arc:EvaluationCondition ; schema:name "Baseline A — unconstrained Agentic ER"@en ; schema:description "An Agentic ER condition without the proposed mutation-authorization boundary."@en .
arc:BaselineB a arc:EvaluationCondition ; schema:name "Baseline B — conventional identifier/default-deny rules"@en ; schema:description "A condition using conventional identifier constraints and abstention when required evidence is missing."@en .
arc:BaselineC a arc:EvaluationCondition ; schema:name "Baseline C — generic authorization boundary"@en ; schema:description "A generic two-phase mutation gate with claim-specific evidence separation but policy rules authored without the DIO/ODI diagnostic mapping."@en .
arc:Challenger a arc:EvaluationCondition ; schema:name "Challenger — DIO/ODI-informed guardrail"@en ; schema:description "The same gate and controlled resources as Baseline C, with shared domain facts organized through the DIO/ODI diagnostic-to-constraint mapping."@en .
arc:PolicyAuthoringTeams a arc:EvaluationControl ; schema:name "Independent policy-authoring teams"@en ; schema:description "Independently constituted authoring teams used to reduce team-specific policy-authoring skill as a confound in the Baseline C–Challenger comparison."@en .
arc:CaseInventory a arc:EvaluationControl ; schema:name "Shared case inventory"@en ; schema:description "The same prespecified cases and splits used for Baseline C and Challenger."@en .
arc:DomainFactInventory a arc:EvaluationControl ; schema:name "Shared domain-fact inventory"@en ; schema:description "The same underlying domain-fact annotations are available to both compared conditions."@en .
arc:EvidencePromotionProcess a arc:EvaluationControl ; schema:name "Shared evidence-promotion process"@en ; schema:description "The same claim-specific promotion process is used in Baseline C and Challenger so its quality is not the treatment contrast."@en .
arc:ValidatorClass a arc:EvaluationControl ; schema:name "Matched validator class"@en ; schema:description "The same validator class and configuration are used in Baseline C and Challenger; policy-derived q_m differences are reported because they are part of the intended policy-organization pathway."@en .
arc:ActionResourceBudget a arc:EvaluationControl ; schema:name "Matched action resources"@en ; schema:description "The compared conditions receive matched action/tool resources."@en .
arc:DecisionBudget a arc:EvaluationControl ; schema:name "Matched decision budget"@en ; schema:description "The compared conditions receive a matched decision budget."@en .
arc:PolicyAuthoringProtocol a arc:EvaluationControl ; schema:name "Policy-authoring and blinding protocol"@en ; schema:description "A prespecified protocol matches authoring effort and relevant expertise, prevents cross-condition policy leakage, and records whether replication across independent teams is performed."@en .
arc:PrespecifiedDecisionMargins a arc:EvaluationControl ; schema:name "Prespecified decision margins δ_SRC and δ_RFCR"@en ; schema:description "Task- and policy-family-specific non-inferiority and materiality margins selected before outcomes are examined, with a prespecified uncertainty procedure."@en .
arc:IndependentGroundTruth a arc:EvaluationResource ; schema:name "Independent ground-truth annotations"@en ; schema:description "Independent labels used to distinguish policy-permitted mutations from referential correctness and to calculate outcome metrics."@en .
arc:IncrementalValueHypothesis a arc:EvaluationHypothesis ; schema:name "Incremental-value hypothesis for DIO/ODI mapping"@en ; schema:description "The empirical hypothesis that diagnostic organization and its explicit constraint mapping improve the safety/coverage trade-off beyond a matched generic authorization boundary."@en .
arc:DependencyAwareEvidenceFlow a arc:FutureResearch ; schema:name "Dependency-aware evidence flow"@en ; schema:description "A possible future layer for recording hypothesis/action/query/observation/claim derivation lineage and controlling feedback into planning."@en .
arc:ObservationContext a arc:PolicyScope ; schema:name "Bound observation context ω"@en ; schema:description "The observation context fixed by the domain-policy instance bound through v_pol; it is not a free evaluation input."@en .
arc:TargetEffectScope a arc:AuthorizationScope ; schema:name "Mutation target/effect scope"@en ; schema:description "The declared target and permitted effect scope supplied to mutation-specific required-claim derivation and bound in authorization."@en .
arc:AuthorizationEligibilityState a arc:EvidenceState ; schema:name "Authorization-eligibility state"@en ; schema:description "The versioned state of proposition- and context-specific promotion eligibility, included in the consistent snapshot."@en .
arc:GraphVersion a arc:StateVersion ; schema:name "Graph version v_G"@en ; schema:description "The graph-state version bound for a protected mutation and revalidated atomically at commit."@en .
arc:EvidenceStateVersion a arc:StateVersion ; schema:name "Evidence-state version v_E"@en ; schema:description "One version covering P_active, P_quar, and authorization-eligibility changes, including admission, adjudication, promotion, demotion, and revocation."@en .
arc:PolicyVersion a arc:StateVersion ; schema:name "Domain-policy version v_pol"@en ; schema:description "The version of the domain-policy instance that fixes applicable constraints, observation context, temporal conditions, and required-claim derivation."@en .
arc:ShadowVersion a arc:StateVersion ; schema:name "Shadow-state version v_S"@en ; schema:description "The version of isolated shadow state when a shadow layer is used and bound to the relevant action."@en .
arc:PromotionValidationRecord a arc:EvidenceRecord ; schema:name "Promotion/validation record identifier"@en ; schema:description "A stable identifier for the claim-specific promotion and validation basis relied on for each required proposition."@en .
arc:SharedOriginIndependenceRule a arc:PromotionConstraint ; schema:name "Recorded shared-origin independence restriction"@en ; schema:description "A promotion restriction that prevents observations with recorded shared upstream query, hypothesis, source, or derivation origins from being counted as independent corroboration merely because they are separate items."@en .
arc:ShadowLineageExclusionRule a arc:PromotionConstraint ; schema:name "Recorded shadow-lineage exclusion"@en ; schema:description "A promotion restriction excluding a shadow candidate and recorded claims transitively based on shadow content from positive authorization support."@en .
arc:AdmissionConflictOutcome a arc:OutcomeSet ; schema:name "Admission conflict outcome"@en ; schema:description "A mutation-independent admission result distinguishing conflict, no conflict detected, and indeterminate; no-conflict-detected is not positive identity evidence."@en .
arc:AdmissionConflict a arc:AdmissionOutcome ; schema:name "CONFLICT admission result"@en ; schema:description "A supported material conflict that retains the observation in quarantine."@en .
arc:AdmissionNoConflictDetected a arc:AdmissionOutcome ; schema:name "NO_CONFLICT_DETECTED admission result"@en ; schema:description "The admission check did not establish a conflict; this is not a guarantee that all conflicts are absent and is not positive identity evidence."@en .
arc:AdmissionIndeterminate a arc:AdmissionOutcome ; schema:name "INDETERMINATE admission result"@en ; schema:description "A plausible material conflict that cannot be resolved on the available admission basis and therefore retains the observation in quarantine."@en .
arc:StatusPrecedenceRule a arc:EvaluationRule ; schema:name "Evaluation-status precedence rule"@en ; schema:description "The required aggregation order BREACH before UNKNOWN_EVIDENCE before PASS."@en .
arc:HumanAdjudicationBranch a arc:ControlBranch ; schema:name "Policy-conditioned human-adjudication branch"@en ; schema:description "A conditional UNKNOWN_EVIDENCE path to human adjudication only when policy requires it and a reviewer is available."@en .
arc:FreshAuthorizationDecision a arc:AuthorizationDecision ; schema:name "Fresh authorization decision"@en ; schema:description "A new authorization evaluation against current evidence, policy, graph, and relevant state versions after human adjudication changes case disposition."@en .
arc:CommonRetryBudget a arc:ResourceControl ; schema:name "Common retry budget"@en ; schema:description "One retry budget shared across stale-snapshot, version-conflict, shadow-state, and evidence-admission compare-and-swap retry triggers in the two-phase lifecycle."@en .
arc:CorrectiveIdentityMutation a arc:OperationClass ; schema:name "Corrective split or un-merge mutation"@en ; schema:description "A protected identity-changing correction, including splitting or un-merging, with policy-defined propositions distinct from merge authorization."@en .
arc:CommonEvaluationReference a arc:EvaluationResource ; schema:name "Common independent evaluation reference"@en ; schema:description "The condition-independent annotation reference for correctness, safety, admissibility, resolvability, and benignness used by SRC, UAR, and FPIR."@en .
arc:IndependentCaseConstruction a arc:EvaluationControl ; schema:name "Independent case and stratum construction"@en ; schema:description "Construction or review of test cases and strata by a party outside both policy-authoring teams and without access to frozen condition policies."@en .
arc:TaxonomyNeutralStratum a arc:EvaluationControl ; schema:name "Taxonomy-neutral evaluation stratum"@en ; schema:description "A stratum defined from observable case facts without DIO/ODI diagnostic labels, reported alongside diagnostic strata."@en .
arc:OutcomeAdjudicators a arc:EvaluationControl ; schema:name "Independent outcome adjudicators"@en ; schema:description "Adjudicators independent of policy authors and masked to condition where practicable, applying the common evaluation reference."@en .
arc:AuthorTeamAllocation a arc:EvaluationControl ; schema:name "Prespecified author-team allocation"@en ; schema:description "Random or expertise-blocked assignment of independent author teams to conditions for stronger comparative inference."@en .
arc:PriorDIOExposureRecord a arc:EvaluationControl ; schema:name "Prior DIO/ODI exposure record"@en ; schema:description "A record of policy authors' prior exposure to DIO/ODI materials, used to assess possible contamination of the authoring contrast."@en .
arc:ValidatorConfiguration a arc:EvaluationControl ; schema:name "Matched validator configuration"@en ; schema:description "The validator configuration held constant across Baseline C and Challenger; policy-derived q_m differences are recorded rather than suppressed."@en .
arc:OutcomeCountingCodebook a arc:EvaluationControl ; schema:name "Outcome counting codebook"@en ; schema:description "A prespecified codebook for unique operation attempts, retries, terminal case resolution, non-match outcomes, unknown outcomes, confusion-matrix mapping, and zero denominators."@en .
arc:UniqueMutationAttempt a arc:EvaluationUnit ; schema:name "Unique protected mutation attempt"@en ; schema:description "A mutation intention identified by operation_id; retries and re-evaluations for the same operation_id count once."@en .
arc:OutcomeCutoff a arc:EvaluationControl ; schema:name "Fixed outcome and reconciliation cutoff"@en ; schema:description "The prespecified observation-window endpoint at which terminal case and transaction outcomes are classified; unresolved transaction outcomes remain unknown."@en .
arc:UndefinedRFCRBranch a arc:DecisionRule ; schema:name "Undefined-RFCR decision branch"@en ; schema:description "If RFCR is undefined in either condition, RFCR-based comparative routes are non-evaluable and do not establish safety superiority or inferiority."@en .
arc:MultiplicityControlRule a arc:EvaluationControl ; schema:name "Two-route inference calibration"@en ; schema:description "The prespecified uncertainty procedure accounts for the alternative-route OR decision structure and calibrates the overall claim criterion, for example through simultaneous bounds or another justified multiplicity-control approach."@en .
arc:AuthorTeamPerformanceContrast a arc:EvaluationUnit ; schema:name "Author-team-level performance contrast"@en ; schema:description "The primary aggregation target for stronger multi-team inference, respecting between-team variation rather than treating repeated runs as independent authoring replications."@en .
arc:RequiredClaimDerivation a arc:AuthorizationFunction ; schema:name "Supervisor-side required-claim derivation"@en ; schema:description "The derivation operation that takes the proposed mutation, target/effect scope, configured constraints, and applicable policy version to produce q_m."@en .
arc:TemporalApplicability a arc:PolicyScope ; schema:name "Temporal applicability scope"@en ; schema:description "The validity interval or temporal condition against which a claim or configured constraint is assessed where relevant."@en .
<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> a arc:EpistemicStatus ; schema:name "specified"@en ; schema:description "Explicitly defined in the current conceptual architecture or interface specification."@en .
<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/assumed> a arc:EpistemicStatus ; schema:name "assumed"@en ; schema:description "Required for the conditional property but not independently established by the architecture."@en .
<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/illustrative> a arc:EpistemicStatus ; schema:name "illustrative"@en ; schema:description "A possible pathway or example, not asserted as universal or inevitable."@en .
<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/proposed-evaluation> a arc:EpistemicStatus ; schema:name "proposed evaluation"@en ; schema:description "A prospective evaluation element; no empirical result is asserted."@en .
<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/future-research> a arc:EpistemicStatus ; schema:name "future research"@en ; schema:description "A direction explicitly outside the current architecture."@en .
<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/canonical-reference> a arc:EpistemicStatus ; schema:name "canonical reference"@en ; schema:description "An existing canonical DIO/ODI concept referenced without redefining it."@en .

arc:distinguishesActionClass a rdf:Property ; rdfs:label "distinguishes Action Class"@en .
arc:doesNotPrebindUnrelatedVersionOf a rdf:Property ; rdfs:label "does Not Prebind Unrelated Version Of"@en .
arc:admitsAgainstCurrentVersionOf a rdf:Property ; rdfs:label "admits Against Current Version Of"@en .
arc:returnsObservationTo a rdf:Property ; rdfs:label "returns Observation To"@en .
arc:bindsOnlyRequiredVersionOf a rdf:Property ; rdfs:label "binds Only Required Version Of"@en .
arc:requiresPostExecutionConfirmationBy a rdf:Property ; rdfs:label "requires Post Execution Confirmation By"@en .
arc:stagesOnlyInto a rdf:Property ; rdfs:label "stages Only Into"@en .
arc:doesNotAuthorizePublicationTo a rdf:Property ; rdfs:label "does Not Authorize Publication To"@en .
arc:requiresPositiveVerificationOf a rdf:Property ; rdfs:label "requires Positive Verification Of"@en .
arc:separatesStagingFrom a rdf:Property ; rdfs:label "separates Staging From"@en .
arc:includesWhenEvaluating a rdf:Property ; rdfs:label "includes When Evaluating"@en .
arc:coversWhenBound a rdf:Property ; rdfs:label "covers When Bound"@en .
arc:comparesVersionsAndWritesAtSameLinearizationPointAs a rdf:Property ; rdfs:label "compares Versions And Writes At Same Linearization Point As"@en .
arc:advancesOnSuccessfulStaging a rdf:Property ; rdfs:label "advances On Successful Staging"@en .
arc:retriesVersionMismatchWithin a rdf:Property ; rdfs:label "retries Version Mismatch Within"@en .
arc:mustBePositivelyEstablishedBefore a rdf:Property ; rdfs:label "must Be Positively Established Before"@en .
arc:uncertaintyRoutesOperationTo a rdf:Property ; rdfs:label "uncertainty Routes Operation To"@en .
arc:isIndependentOf a rdf:Property ; rdfs:label "is Independent Of"@en .
arc:returns a rdf:Property ; rdfs:label "returns"@en .
arc:permitsPassOnlyWithOtherRequirementsSatisfied a rdf:Property ; rdfs:label "permits Pass Only With Other Requirements Satisfied"@en .
arc:prevents a rdf:Property ; rdfs:label "prevents"@en .
arc:yieldsWhenProhibitiveConditionIsEstablished a rdf:Property ; rdfs:label "yields When Prohibitive Condition Is Established"@en .
arc:yields a rdf:Property ; rdfs:label "yields"@en .
arc:isGovernedBy a rdf:Property ; rdfs:label "is Governed By"@en .
arc:advances a rdf:Property ; rdfs:label "advances"@en .
arc:requiresReadmissionThrough a rdf:Property ; rdfs:label "requires Readmission Through"@en .
arc:releasesOnlyAsUnverifiedTo a rdf:Property ; rdfs:label "releases Only As Unverified To"@en .
arc:doesNotDirectlyPromoteInto a rdf:Property ; rdfs:label "does Not Directly Promote Into"@en .
arc:mayBeChangedOnlyThrough a rdf:Property ; rdfs:label "may Be Changed Only Through"@en .
arc:doesNotDirectlyChangeEligibility a rdf:Property ; rdfs:label "does not directly change eligibility"@en .
arc:mayBeChangedThroughVersionedAdjudication a rdf:Property ; rdfs:label "may Be Changed Through Versioned Adjudication"@en .
arc:cannotAlterDirectly a rdf:Property ; rdfs:label "cannot Alter Directly"@en .
arc:cannotSetDirectly a rdf:Property ; rdfs:label "cannot Set Directly"@en .

arc:ReadAction a arc:OperationClass ;
  schema:name "READ"@en ;
  schema:description "Retrieval or exploration within a declared scope. Its authorization is scope/policy-bound but does not pre-bind unrelated graph or evidence versions that would force replay of the retrieval; the returned observation is admitted against the current evidence state."@en .

arc:StageLocalAction a arc:OperationClass ;
  schema:name "STAGE_LOCAL"@en ;
  schema:description "Local preparation with no shared-state effects. Its authorization binds local dependency versions only when the declared operation explicitly depends on them; post-execution validation confirms that no shared-state effects occurred."@en .

arc:ReversibleWriteAction a arc:OperationClass ;
  schema:name "REVERSIBLE_WRITE"@en ;
  schema:description "A provisional write authorized only to an isolated staging target such as G_shadow. It must be positively shown to be separated from production identity state, Planner-visible shared identity state, downstream consumers, and P_auth inputs; it never authorizes publication to G_prod."@en .

arc:IrreversibleWriteAction a arc:OperationClass ;
  schema:name "IRREVERSIBLE_WRITE"@en ;
  schema:description "The protected action class for operations whose realized or potential shared effects can persistently alter identity interpretation. Ambiguous classification or unverifiable staging isolation is handled through this protected path."@en .

arc:ProductionGraph a arc:GraphState ;
  schema:name "Production graph G_prod"@en ;
  schema:description "The persistent shared graph whose identity interpretation must not be affected by a REVERSIBLE_WRITE."@en .

arc:ShadowGraph a arc:GraphState ;
  schema:name "Isolated shadow graph G_shadow"@en ;
  schema:description "A staging target for an explicitly authorized REVERSIBLE_WRITE. Staging there is provisional and does not authorize publication to the production graph."@en .

arc:StagingIsolationState a arc:IsolationState ;
  schema:name "Staging-isolation state"@en ;
  schema:description "The separately represented state describing whether a staging target is isolated from production identity state, Planner-visible shared identity state, downstream consumers, and all P_auth inputs. It is included in the relevant snapshot for REVERSIBLE_WRITE evaluation."@en .

arc:StagingIsolationVersion a arc:StateVersion ;
  schema:name "Separately represented staging-isolation-state version"@en ;
  schema:description "An optional version identifier for staging-isolation state when that state is separately versioned. The manuscript requires any such relevant version to be bound and revalidated but does not prescribe a dedicated symbol."@en .

arc:LocalDependencyVersion a arc:StateVersion ;
  schema:name "Action-bound local dependency version"@en ;
  schema:description "A version of a local dependency explicitly bound when a STAGE_LOCAL operation depends on it. Shared-state versions are not required for that action unless the operation explicitly depends on them."@en .

arc:PlannerVisibleSharedIdentityState a arc:EvidenceState ;
  schema:name "Planner-visible shared identity state"@en ;
  schema:description "Shared identity-related state visible to the Planner, from which a REVERSIBLE_WRITE must remain isolated."@en .

arc:DownstreamConsumers a arc:Component ;
  schema:name "Downstream consumers"@en ;
  schema:description "External or downstream consumers that must not observe effects of a provisional REVERSIBLE_WRITE before a protected production mutation is separately authorized."@en .

arc:ClaimConflictCheck a arc:Process ;
  schema:name "Claim-specific conflict check"@en ;
  schema:description "A mutation-specific CheckClaimConflict(q_m, P_auth, P_active, P_quar), distinct from the mutation-independent evidence-admission check. It determines whether material conflict bearing on the required propositions is clear, established, or indeterminate."@en .

arc:ClaimConflictClear a arc:ClaimConflictOutcome ;
  schema:name "CLEAR"@en ;
  schema:description "No unresolved material conflict bearing on the required propositions is detected in the checked evidence state. CLEAR is a necessary conflict condition for PASS, not proof that unobserved conflicts do not exist."@en .

arc:ClaimConflictDetected a arc:ClaimConflictOutcome ;
  schema:name "CONFLICT"@en ;
  schema:description "Claim-specific authorization-eligible evidence establishes a relevant contradiction or policy-prohibitive condition for a required proposition."@en .

arc:ClaimConflictIndeterminate a arc:ClaimConflictOutcome ;
  schema:name "INDETERMINATE"@en ;
  schema:description "A possible material conflict is indicated only by UNVERIFIED or quarantined evidence, or by authorization-eligible items that cannot be reconciled under applicable authority and temporal rules."@en .

arc:QuarantineDispositionDecision a arc:Process ;
  schema:name "Quarantine disposition under policy/adjudication"@en ;
  schema:description "A mapping label for the policy-designated adjudication or versioned-rule decision that changes a quarantined item's disposition. The decision is recorded, advances evidence-state version, and requires a fresh admission check before release; release to P_active confers only UNVERIFIED status, not claim-specific eligibility."@en .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R155> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:Architecture ;
  rdf:predicate arc:distinguishesActionClass ;
  rdf:object arc:ReadAction ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1" ;
  arc:interpretationNote "The interface defines READ as a distinct action class with scope-bound retrieval authorization." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R156> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:Architecture ;
  rdf:predicate arc:distinguishesActionClass ;
  rdf:object arc:StageLocalAction ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1" ;
  arc:interpretationNote "The interface defines STAGE_LOCAL as a distinct action class requiring no shared-state effects." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R157> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:Architecture ;
  rdf:predicate arc:distinguishesActionClass ;
  rdf:object arc:ReversibleWriteAction ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1" ;
  arc:interpretationNote "The interface defines REVERSIBLE_WRITE as a provisional, isolated staging action rather than a production commit." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R158> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:Architecture ;
  rdf:predicate arc:distinguishesActionClass ;
  rdf:object arc:IrreversibleWriteAction ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1" ;
  arc:interpretationNote "The interface defines IRREVERSIBLE_WRITE as the protected path for operations with potentially persistent shared identity effects." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R159> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ReadAction ;
  rdf:predicate arc:doesNotPrebindUnrelatedVersionOf ;
  rdf:object arc:GraphVersion ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 2" ;
  arc:interpretationNote "A READ does not bind a pre-retrieval graph version whose unrelated change would force the retrieval to be replayed." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R160> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ReadAction ;
  rdf:predicate arc:doesNotPrebindUnrelatedVersionOf ;
  rdf:object arc:EvidenceStateVersion ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 2" ;
  arc:interpretationNote "A READ does not bind a pre-retrieval evidence version whose unrelated change would force the retrieval to be replayed." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R161> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ReadAction ;
  rdf:predicate arc:admitsAgainstCurrentVersionOf ;
  rdf:object arc:EvidenceStateVersion ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 2" ;
  arc:interpretationNote "The returned observation is admitted against the current evidence-state version after retrieval; a stale unrelated pre-retrieval version does not cause READ replay." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R162> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ReadAction ;
  rdf:predicate arc:returnsObservationTo ;
  rdf:object arc:QuarantineEvidence ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 2" ;
  arc:interpretationNote "A READ result is first placed in quarantine and only then considered for admission to P_active as UNVERIFIED." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R163> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:StageLocalAction ;
  rdf:predicate arc:bindsOnlyRequiredVersionOf ;
  rdf:object arc:LocalDependencyVersion ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 2" ;
  arc:interpretationNote "A STAGE_LOCAL authorization binds a local dependency version only when the declared local operation explicitly depends on it." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R164> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:StageLocalAction ;
  rdf:predicate arc:requiresPostExecutionConfirmationBy ;
  rdf:object arc:Phase2Validation ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 2" ;
  arc:interpretationNote "After local execution the Supervisor confirms that no shared-state effects occurred; otherwise the result is rejected." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R165> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ReversibleWriteAction ;
  rdf:predicate arc:stagesOnlyInto ;
  rdf:object arc:ShadowGraph ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 1; Algorithm 2" ;
  arc:interpretationNote "A REVERSIBLE_WRITE is authorized only for isolated staging in G_shadow." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R166> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ReversibleWriteAction ;
  rdf:predicate arc:doesNotAuthorizePublicationTo ;
  rdf:object arc:ProductionGraph ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 1; Algorithm 2" ;
  arc:interpretationNote "A staging authorization is not permission to publish or merge the candidate into G_prod; a later production mutation needs a new protected authorization." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R167> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ReversibleWriteAction ;
  rdf:predicate arc:requiresPositiveVerificationOf ;
  rdf:object arc:StagingIsolationState ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 1; Algorithm 2" ;
  arc:interpretationNote "Isolation must be positively established under policy; if it cannot be verified, the candidate is discarded and no staging write occurs." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R168> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ReversibleWriteAction ;
  rdf:predicate arc:bindsVersion ;
  rdf:object arc:ShadowVersion ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 1; Algorithm 2" ;
  arc:interpretationNote "The action binds and revalidates v_S for the shadow staging target." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R169> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ReversibleWriteAction ;
  rdf:predicate arc:bindsVersion ;
  rdf:object arc:PolicyVersion ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 1; Algorithm 2" ;
  arc:interpretationNote "The action binds and revalidates the applicable domain-policy version v_pol." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R170> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ReversibleWriteAction ;
  rdf:predicate arc:conditionallyBindsVersion ;
  rdf:object arc:StagingIsolationVersion ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 1; Algorithm 2" ;
  arc:interpretationNote "If staging-isolation state is separately versioned, that version is bound to the authorization and checked at the staging linearization point; no dedicated symbol is prescribed." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R171> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:StagingIsolationState ;
  rdf:predicate arc:separatesStagingFrom ;
  rdf:object arc:ProductionGraph ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 1; Algorithm 2" ;
  arc:interpretationNote "The staging target must be isolated from production identity state." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R172> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:StagingIsolationState ;
  rdf:predicate arc:separatesStagingFrom ;
  rdf:object arc:PlannerVisibleSharedIdentityState ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 1; Algorithm 2" ;
  arc:interpretationNote "The staging target must be isolated from Planner-visible shared identity state." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R173> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:StagingIsolationState ;
  rdf:predicate arc:separatesStagingFrom ;
  rdf:object arc:DownstreamConsumers ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 1; Algorithm 2" ;
  arc:interpretationNote "The staging target must be isolated from downstream consumers." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R174> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:StagingIsolationState ;
  rdf:predicate arc:separatesStagingFrom ;
  rdf:object arc:AuthorizationEligibleEvidenceSet ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 1; Algorithm 2" ;
  arc:interpretationNote "The staging target and its effects must remain isolated from all P_auth inputs." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R175> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:CommitSnapshot ;
  rdf:predicate arc:includesWhenEvaluating ;
  rdf:object arc:StagingIsolationState ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 2" ;
  arc:interpretationNote "The consistent snapshot includes staging-isolation state when a REVERSIBLE_WRITE is evaluated." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R176> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:CommitSnapshot ;
  rdf:predicate arc:conditionallyIncludesVersionOf ;
  rdf:object arc:StagingIsolationVersion ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 2" ;
  arc:interpretationNote "The snapshot includes the version of staging-isolation state when that state is separately versioned." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R177> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:VersionValidity ;
  rdf:predicate arc:coversWhenBound ;
  rdf:object arc:StagingIsolationVersion ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 2" ;
  arc:interpretationNote "VersionsValid covers every staging-relevant version bound to the REVERSIBLE_WRITE authorization, including a separately represented isolation-state version." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R178> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ReversibleWriteAction ;
  rdf:predicate arc:comparesVersionsAndWritesAtSameLinearizationPointAs ;
  rdf:object arc:CommitSnapshot ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 2" ;
  arc:interpretationNote "The shadow write and the comparison of v_S, v_pol, and every other staging-relevant bound version are one atomic operation at the action's linearization point." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R179> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ReversibleWriteAction ;
  rdf:predicate arc:advancesOnSuccessfulStaging ;
  rdf:object arc:ShadowVersion ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 2" ;
  arc:interpretationNote "A successful isolated staging operation advances v_S and returns SHADOW_STAGED_PROVISIONAL." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R180> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ReversibleWriteAction ;
  rdf:predicate arc:retriesVersionMismatchWithin ;
  rdf:object arc:CommonRetryBudget ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 2" ;
  arc:interpretationNote "A staging-relevant version mismatch prevents the write and triggers RETRY_REEVALUATE or TRANSACTION_RETRY_EXHAUSTED under the common retry budget." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R181> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:StagingIsolationState ;
  rdf:predicate arc:mustBePositivelyEstablishedBefore ;
  rdf:object arc:ReversibleWriteAction ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 1" ;
  arc:interpretationNote "A candidate may be classified as REVERSIBLE_WRITE only when the isolation conditions are positively established under policy." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R182> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:StagingIsolationState ;
  rdf:predicate arc:uncertaintyRoutesOperationTo ;
  rdf:object arc:IrreversibleWriteAction ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; Algorithm 1; Algorithm 2" ;
  arc:interpretationNote "If classification or isolation is uncertain, the intended shared effect is treated as IRREVERSIBLE_WRITE and must use the protected authorization path." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R183> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:AdmissionConflictCheck ;
  rdf:predicate arc:isIndependentOf ;
  rdf:object arc:RequiredPropositionSet ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; Algorithm 2" ;
  arc:interpretationNote "The admission conflict check is mutation-independent and does not depend on mutation-specific q_m; it decides quarantine admission, not claim support." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R184> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:Phase1Authorization ;
  rdf:predicate arc:uses ;
  rdf:object arc:ClaimConflictCheck ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; §6.2; Algorithm 1" ;
  arc:interpretationNote "The pre-execution authorization checks claim-specific material conflicts bearing on q_m." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R185> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:Phase2Validation ;
  rdf:predicate arc:uses ;
  rdf:object arc:ClaimConflictCheck ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; §6.3; Algorithm 2" ;
  arc:interpretationNote "The post-execution evaluation rechecks claim-specific conflicts for the realized candidate against the same snapshot." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R186> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ClaimConflictCheck ;
  rdf:predicate arc:evaluates ;
  rdf:object arc:RequiredPropositionSet ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; §5.4" ;
  arc:interpretationNote "The conflict check is scoped to the mutation-specific required proposition set q_m." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R187> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ClaimConflictCheck ;
  rdf:predicate arc:assesses ;
  rdf:object arc:AuthorizationEligibleEvidenceSet ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; §5.4" ;
  arc:interpretationNote "Claim-specific authorization-eligible evidence can establish a relevant contradiction or policy-prohibitive condition." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R188> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ClaimConflictCheck ;
  rdf:predicate arc:assesses ;
  rdf:object arc:ActiveEvidenceSet ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; §5.4" ;
  arc:interpretationNote "UNVERIFIED material in P_active can indicate a possible material conflict and produce INDETERMINATE, but cannot itself establish mutation-level BREACH or positive support." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R189> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ClaimConflictCheck ;
  rdf:predicate arc:assesses ;
  rdf:object arc:QuarantineEvidence ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; §5.4" ;
  arc:interpretationNote "Materially relevant quarantined evidence can indicate an unresolved conflict and therefore prevent PASS." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R190> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ClaimConflictCheck ;
  rdf:predicate arc:returns ;
  rdf:object arc:ClaimConflictClear ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; §5.4" ;
  arc:interpretationNote "CLEAR is returned only when no unresolved material conflict bearing on q_m is detected in the checked evidence state." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R191> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ClaimConflictCheck ;
  rdf:predicate arc:returns ;
  rdf:object arc:ClaimConflictDetected ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; §5.4" ;
  arc:interpretationNote "CONFLICT is returned only when claim-specific authorization-eligible evidence establishes a relevant contradiction or prohibitive condition." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R192> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ClaimConflictCheck ;
  rdf:predicate arc:returns ;
  rdf:object arc:ClaimConflictIndeterminate ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; §5.4" ;
  arc:interpretationNote "INDETERMINATE is returned when a possible conflict is indicated by UNVERIFIED or quarantined evidence, or conflicting eligible items cannot be reconciled under policy." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R193> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ClaimConflictClear ;
  rdf:predicate arc:permitsPassOnlyWithOtherRequirementsSatisfied ;
  rdf:object arc:OutcomePASS ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; §5.4" ;
  arc:interpretationNote "CLEAR is necessary but not sufficient for PASS; positive support, constraints, scope, and versions must also pass." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R194> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ClaimConflictDetected ;
  rdf:predicate arc:prevents ;
  rdf:object arc:OutcomePASS ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; §5.4" ;
  arc:interpretationNote "An established claim-specific conflict prevents PASS." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R195> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ClaimConflictIndeterminate ;
  rdf:predicate arc:prevents ;
  rdf:object arc:OutcomePASS ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; §5.4" ;
  arc:interpretationNote "An unresolved or indeterminate material conflict prevents PASS." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R196> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ClaimConflictDetected ;
  rdf:predicate arc:yieldsWhenProhibitiveConditionIsEstablished ;
  rdf:object arc:OutcomeBREACH ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; §5.4" ;
  arc:interpretationNote "A relevant contradiction or explicit prohibitive condition established by authorization-eligible evidence is evaluated as BREACH." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R197> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ClaimConflictIndeterminate ;
  rdf:predicate arc:yields ;
  rdf:object arc:OutcomeUNKNOWN ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; §5.4" ;
  arc:interpretationNote "A possible or unreconciled material conflict is UNKNOWN_EVIDENCE rather than a semantic verdict that the identity claim is false." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R198> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:QuarantineDispositionDecision ;
  rdf:predicate arc:isGovernedBy ;
  rdf:object arc:DomainPolicy ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3" ;
  arc:interpretationNote "A quarantined item's disposition is determined by a policy-designated adjudication or a versioned rule, not by escalation alone." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R199> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:QuarantineDispositionDecision ;
  rdf:predicate arc:advances ;
  rdf:object arc:EvidenceStateVersion ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; §6.1" ;
  arc:interpretationNote "A recorded disposition decision advances v_E because the relevant evidence state has changed." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R200> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:QuarantineDispositionDecision ;
  rdf:predicate arc:requiresReadmissionThrough ;
  rdf:object arc:AdmissionConflictCheck ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; Algorithm 2" ;
  arc:interpretationNote "Before release from quarantine to P_active, the disposition must be recorded and a fresh admission check must be run against current evidence state." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R201> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:QuarantineDispositionDecision ;
  rdf:predicate arc:releasesOnlyAsUnverifiedTo ;
  rdf:object arc:ActiveEvidenceSet ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3" ;
  arc:interpretationNote "Release to P_active confers only UNVERIFIED status; it does not confer claim-specific authorization eligibility." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R202> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:QuarantineDispositionDecision ;
  rdf:predicate arc:doesNotDirectlyPromoteInto ;
  rdf:object arc:AuthorizationEligibleEvidenceSet ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3" ;
  arc:interpretationNote "Quarantine disposition is not claim-specific promotion; separate promotion is required for any P_auth eligibility." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R203> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:AuthorizationEligibilityState ;
  rdf:predicate arc:mayBeChangedOnlyThrough ;
  rdf:object arc:ClaimSpecificPromotion ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; §6.1" ;
  arc:interpretationNote "Eligibility metadata may be written or changed by the designated claim-specific promotion process." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R204> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:QuarantineDispositionDecision ;
  rdf:predicate arc:doesNotDirectlyChangeEligibility ;
  rdf:object arc:AuthorizationEligibilityState ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; §6.1" ;
  arc:interpretationNote "A quarantine-disposition decision that releases an item to P_active confers only UNVERIFIED status and does not itself change claim-specific authorization eligibility; any separate versioned policy/adjudication change to eligibility must trigger a fresh authorization decision." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R205> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:Planner ;
  rdf:predicate arc:cannotAlterDirectly ;
  rdf:object arc:AuthorizationEligibilityState ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; §6.1" ;
  arc:interpretationNote "The Planner cannot directly assign or alter authorization-eligibility metadata." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R206> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:EvidenceObservation ;
  rdf:predicate arc:cannotSetDirectly ;
  rdf:object arc:AuthorizationEligibilityState ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.3; §6.1" ;
  arc:interpretationNote "Raw tool outputs cannot directly assign or alter authorization-eligibility metadata." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R001> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:Architecture ;
  rdf:predicate arc:informedBy ;
  rdf:object dio:DIO ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§1; §5.2" ;
  arc:interpretationNote "The architecture explicitly draws on the DIO framework as its applied diagnostic basis." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R002> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:Architecture ;
  rdf:predicate arc:informedBy ;
  rdf:object dio:ODI ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§1; §5.2" ;
  arc:interpretationNote "ODI supplies the conceptual layer for the identity and reconstruction distinctions used by the paper." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R003> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:Architecture ;
  rdf:predicate arc:referencesAnalyticalLayer ;
  rdf:object dio:MVDIO ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6" ;
  arc:interpretationNote "The proposed Supervisor is named as an MVDIO Supervisor Layer; this relation does not imply that the architecture is a complete MVDIO implementation." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R004> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:Architecture ;
  rdf:predicate arc:addresses ;
  rdf:object arc:AgenticERContext ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§1; §3" ;
  arc:interpretationNote "The target setting is Agentic Entity Resolution with persistent identity-changing graph mutations." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R005> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:Architecture ;
  rdf:predicate arc:analyzesPossiblePathway ;
  rdf:object arc:ApparentVerification ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/illustrative> ;
  arc:sourceSection "§4.1" ;
  arc:interpretationNote "Apparent verification is a possible hypothesis-conditioned feedback pathway, not an inevitable outcome." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R006> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ApparentVerification ;
  rdf:predicate arc:mayAriseThrough ;
  rdf:object arc:HypothesisConditionedRetrieval ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/illustrative> ;
  arc:sourceSection "§4.1" ;
  arc:interpretationNote "A mistaken hypothesis may condition later query/action selection and make retrieved material appear confirmatory." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R007> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ConstraintBindingFunction ;
  rdf:predicate arc:mapsSelectedDistinctionsFrom ;
  rdf:object dio:ReconstructionFailureMode ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.2" ;
  arc:interpretationNote "The mapping is partial and restricted to selected diagnostic distinctions; it does not cover or redefine the full vocabulary." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R008> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ConstraintBindingFunction ;
  rdf:predicate arc:usesDiagnosticBranch ;
  rdf:object dio:ReferentialReconstructionFailure ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.2" ;
  arc:interpretationNote "This diagnostic branch is among the selected input distinctions for domain-governed constraint binding." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R009> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ConstraintBindingFunction ;
  rdf:predicate arc:usesDiagnosticBranch ;
  rdf:object dio:SemanticCoherenceFailure ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.2" ;
  arc:interpretationNote "This diagnostic branch is among the selected input distinctions for domain-governed constraint binding." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R010> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ConstraintBindingFunction ;
  rdf:predicate arc:usesDiagnosticBranch ;
  rdf:object dio:TemporalReconstructionFailure ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.2" ;
  arc:interpretationNote "This diagnostic branch is among the selected input distinctions for domain-governed constraint binding." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R011> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ConstraintBindingFunction ;
  rdf:predicate arc:usesDiagnosticBranch ;
  rdf:object dio:ContextualAdequacyFailure ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.2" ;
  arc:interpretationNote "This diagnostic branch is among the selected input distinctions for domain-governed constraint binding." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R012> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ConstraintBindingFunction ;
  rdf:predicate arc:producesOrInforms ;
  rdf:object arc:DomainConfiguredConstraints ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.2" ;
  arc:interpretationNote "The output is supplied as explicit domain policy, not generated by automatic SKOS entailment." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R013> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:DomainConfiguredConstraints ;
  rdf:predicate arc:configuredBy ;
  rdf:object arc:DomainPolicy ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/assumed> ;
  arc:sourceSection "§5.2; §5.4" ;
  arc:interpretationNote "Adequacy of the configured constraint set is Assumption 1." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R014> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:DomainPolicy ;
  rdf:predicate arc:scopedTo ;
  rdf:object dio:ObservationDomain ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.1; §5.2" ;
  arc:interpretationNote "The applicable policy represents the observation context and relevant temporal conditions." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R015> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:DomainConfiguredConstraints ;
  rdf:predicate arc:usesConcept ;
  rdf:object dio:IdentityPreservingConstraints ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/canonical-reference> ;
  arc:sourceSection "§5.2" ;
  arc:interpretationNote "The mapping reuses the canonical identity-preserving constraints concept without adding a new canonical definition." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R016> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:DomainConfiguredConstraints ;
  rdf:predicate arc:mayOperationalize ;
  rdf:object dio:ReferentialContinuity ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.2; §7" ;
  arc:interpretationNote "Referential continuity is one identity property that domain-configured constraints may need to preserve." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R081> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject dio:EntitySubstitution ;
  rdf:predicate arc:mapsIllustrativelyTo ;
  rdf:object arc:ExampleReferentCoreferenceConstraint ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/illustrative> ;
  arc:sourceSection "§5.2" ;
  arc:interpretationNote "The example rejects lexical similarity or commercial adjacency as sufficient proof of co-reference; the actual evidentiary rule remains domain-configured." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R082> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject dio:MergeFailure ;
  rdf:predicate arc:mapsIllustrativelyTo ;
  rdf:object arc:ExampleReferentCoreferenceConstraint ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/illustrative> ;
  arc:sourceSection "§5.2" ;
  arc:interpretationNote "The example requires claim-specific co-reference support before merging distinct records; it is not a universal fixed predicate. The same protected boundary applies to corrective splits and un-merges under mutation-specific policy claims." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R083> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject dio:TemporalDiscontinuity ;
  rdf:predicate arc:mapsIllustrativelyTo ;
  rdf:object arc:ExampleTemporalApplicabilityConstraint ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/illustrative> ;
  arc:sourceSection "§5.2" ;
  arc:interpretationNote "The example binds rename or continuity claims to the relevant referent and validity interval." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R084> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject dio:TemporalMisalignment ;
  rdf:predicate arc:mapsIllustrativelyTo ;
  rdf:object arc:ExampleTemporalApplicabilityConstraint ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/illustrative> ;
  arc:sourceSection "§5.2" ;
  arc:interpretationNote "The example makes temporal applicability part of the mutation-specific authorization assessment." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R085> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject dio:SemanticFragmentation ;
  rdf:predicate arc:mapsIllustrativelyTo ;
  rdf:object arc:ExampleMaterialConflictRetentionConstraint ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/illustrative> ;
  arc:sourceSection "§5.2" ;
  arc:interpretationNote "The mapping covers the identity-affecting subset of Semantic Fragmentation: materially incompatible identity-related claims remain unresolved until reconciled; other attribute-level incompatibilities remain governed by domain policy." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R086> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject dio:ContextualDisplacement ;
  rdf:predicate arc:mapsIllustrativelyTo ;
  rdf:object arc:ExampleContextualRelationAdequacyConstraint ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/illustrative> ;
  arc:sourceSection "§5.2" ;
  arc:interpretationNote "A relation may be adequate in one observation purpose and insufficient for a different identity proposition in another." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R087> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject dio:SplitFailure ;
  rdf:predicate arc:mapsIllustrativelyTo ;
  rdf:object arc:ExampleContinuitySupportConstraint ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/illustrative> ;
  arc:sourceSection "§5.2" ;
  arc:interpretationNote "The paper also gives a positive continuity case: distinct records may be resolved when documented, temporally applicable evidence supports one continuing referent." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R017> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:Planner ;
  rdf:predicate arc:proposes ;
  rdf:object arc:ProposedMutation ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.2; Algorithm 1" ;
  arc:interpretationNote "The Planner proposes an action; it does not define or weaken the required authorization claim set." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R018> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ProposedMutation ;
  rdf:predicate arc:hasClass ;
  rdf:object arc:MutationClass ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§6.1; §6.2" ;
  arc:interpretationNote "The operation and its realized or potential shared effects determine whether it is treated as protected." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R019> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:MutationClass ;
  rdf:predicate arc:determinesRequirementsThrough ;
  rdf:object arc:DomainPolicy ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified> ;
  arc:sourceSection "§5.4; Algorithm 1" ;
  arc:interpretationNote "The applicable versioned policy and proposed mutation determine the propositions required for authorization." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R020> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ProposedMutation ;
  rdf:predicate arc:inputTo ;
