  arc:sourceSection "§5.4; §6.3" ;
  arc:interpretationNote "The isolated candidate is assessed against the same consistent commit-time snapshot; the snapshot is not asserted to contain the candidate graph as persistent state." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R047> a rdf:Statement, arc:RelationAssertion ;
