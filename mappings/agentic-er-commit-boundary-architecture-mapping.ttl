  arc:sourceSection "§5.3; Assumption 2" ;
  arc:interpretationNote "The architecture depends on correct application of the stated promotion contract; it does not validate the validator independently." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R035> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:ClaimSpecificPromotion ;
