  arc:sourceSection "§8.1" ;
  arc:interpretationNote "A factual taxonomy-neutral stratum is reported alongside the diagnostic strata." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R126> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:PolicyAuthoringTeams ;
  rdf:predicate arc:allocatedBy ;
  rdf:object arc:AuthorTeamAllocation ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/proposed-evaluation> ;
  arc:sourceSection "§8.1" ;
  arc:interpretationNote "For stronger inference, independent author teams are assigned by a prespecified random or expertise-blocked procedure." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R127> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:PolicyAuthoringTeams ;
  rdf:predicate arc:recordsExposureIn ;
  rdf:object arc:PriorDIOExposureRecord ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/proposed-evaluation> ;
  arc:sourceSection "§8.1" ;
  arc:interpretationNote "Prior DIO/ODI familiarity is recorded to assess possible contamination of the authoring contrast." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R128> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:EvaluationProtocol ;
  rdf:predicate arc:holdsConstantAcrossComparedConditions ;
  rdf:object arc:ValidatorConfiguration ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/proposed-evaluation> ;
  arc:sourceSection "§8.1" ;
  arc:interpretationNote "The validator configuration is shared; policy-derived q_m differences are explicitly reported as part of the treatment pathway." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R129> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:EvaluationProtocol ;
  rdf:predicate arc:governedBy ;
  rdf:object arc:OutcomeCountingCodebook ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/proposed-evaluation> ;
  arc:sourceSection "§8.2" ;
  arc:interpretationNote "The codebook defines operation_id attempts, retries, cutoff, terminal resolution, non-match outcomes, unknown outcomes, confusion mapping, and zero denominators." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R130> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:UniqueMutationAttempt ;
  rdf:predicate arc:identifiedBy ;
  rdf:object arc:OutcomeCutoff ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/proposed-evaluation> ;
  arc:sourceSection "§8.2" ;
  arc:interpretationNote "Operation identifiers define unique attempt units; terminal outcomes are classified at a prespecified cutoff and unresolved outcomes remain unknown." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R131> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:EvaluationProtocol ;
  rdf:predicate arc:usesAnalysisUnit ;
  rdf:object arc:AuthorTeamPerformanceContrast ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/proposed-evaluation> ;
  arc:sourceSection "§8.1; §8.2" ;
  arc:interpretationNote "Stronger comparative inference respects between-team variation; repeated runs of a single policy are not authoring replications." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R132> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:OutcomeUNKNOWN ;
  rdf:predicate arc:triggersNonEvaluabilityWhen ;
  rdf:object arc:UndefinedRFCRBranch ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/proposed-evaluation> ;
  arc:sourceSection "§8.2" ;
  arc:interpretationNote "If RFCR is undefined in either condition, RFCR-based routes are non-evaluable rather than interpreted as safety superiority or inferiority." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R133> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:EvaluationProtocol ;
  rdf:predicate arc:distinguishes ;
  rdf:object arc:OutcomeCutoff ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/proposed-evaluation> ;
  arc:sourceSection "§8.2" ;
  arc:interpretationNote "A fixed reconciliation cutoff separates final unresolved outcomes from cases resolved within the observation window." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R134> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:EvidencePromotionProcess ;
  rdf:predicate arc:heldConstantBetween ;
  rdf:object arc:BaselineC ;
  arc:epistemicStatus <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/proposed-evaluation> ;
  arc:sourceSection "§8.1" ;
  arc:interpretationNote "The promotion process is a common control and shared-origin tests alone do not isolate the DIO/ODI mapping contribution." ;
  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R135> a rdf:Statement, arc:RelationAssertion ;
