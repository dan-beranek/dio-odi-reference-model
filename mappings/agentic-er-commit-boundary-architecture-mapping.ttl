  dcterms:source <https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55> .

<https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R151> a rdf:Statement, arc:RelationAssertion ;
  rdf:subject arc:EvaluationProtocol ;
  rdf:predicate arc:usesIndependentAdjudicators ;
