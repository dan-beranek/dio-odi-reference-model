        "rdf:Statement"
      ],
      "rdf:subject": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#QuarantineDispositionDecision"
      },
      "rdf:predicate": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#isGovernedBy"
