    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#Architecture",
      "@type": "arc:Architecture",
      "schema:name": "DIO/ODI-informed Agentic ER commit-boundary architecture",
      "schema:description": "The proposed conceptual architecture connecting DIO/ODI diagnostics, domain-configured constraints, claim-specific evidence eligibility, action-specific authorization, two-phase validation, and protected commit."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#AgenticERContext",
      "@type": "arc:Context",
      "schema:name": "Agentic Entity Resolution context",
      "schema:description": "An iterative ER setting in which an agent plans actions, acquires evidence, updates hypotheses, and proposes identity-changing graph mutations."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#Planner",
      "@type": "arc:Component",
      "schema:name": "Agentic ER Planner",
      "schema:description": "The component that maintains provisional hypotheses, reasons over Planner-visible evidence, and proposes operations."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ApparentVerification",
      "@type": "arc:AnalyticalConstruct",
      "schema:name": "Apparent verification",
      "schema:description": "A possible feedback-path effect in which hypothesis-conditioned retrieval yields observations that appear to confirm a hypothesis without independently establishing the intended referent."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#HypothesisConditionedRetrieval",
      "@type": "arc:Process",
      "schema:name": "Hypothesis-conditioned retrieval",
      "schema:description": "Evidence acquisition whose query or selection is influenced by an earlier identity hypothesis."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ConstraintBindingFunction",
      "@type": "arc:ArchitectureComponent",
      "schema:name": "Domain-governed constraint-binding function μΩ",
      "schema:description": "A partial design-time mapping from selected DIO/ODI diagnostic distinctions to explicit domain-configured identity-preserving constraints; not automatic SKOS entailment."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#DomainPolicy",
      "@type": "arc:Policy",
      "schema:name": "Versioned domain policy",
      "schema:description": "A versioned policy configuring applicable identity-preserving constraints, required propositions, observation context, temporal conditions, and mutation scope."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#DomainConfiguredConstraints",
      "@type": "arc:ConstraintSet",
      "schema:name": "Domain-configured identity-preserving constraints V_E",
      "schema:description": "The configured conditions evaluated for a declared entity class, observation context, temporal scope where relevant, and mutation class."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ExampleReferentCoreferenceConstraint",
      "@type": "arc:IllustrativeConstraint",
      "schema:name": "Illustrative referent co-reference requirement",
      "schema:description": "An example domain constraint: lexical similarity or a shared commercial neighborhood does not by itself establish that two records denote the same referent."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ExampleTemporalApplicabilityConstraint",
      "@type": "arc:IllustrativeConstraint",
      "schema:name": "Illustrative temporal-applicability requirement",
      "schema:description": "An example domain constraint: a rename or continuity claim must apply to the relevant referent and validity interval."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ExampleMaterialConflictRetentionConstraint",
      "@type": "arc:IllustrativeConstraint",
      "schema:name": "Illustrative material-conflict retention requirement",
      "schema:description": "An example domain constraint: materially incompatible identity-related claims remain a conflict until reconciled; clustering alone does not reconcile them."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ExampleContextualRelationAdequacyConstraint",
      "@type": "arc:IllustrativeConstraint",
      "schema:name": "Illustrative context-sensitive relation-adequacy requirement",
      "schema:description": "An example domain constraint: a relation such as brand_of may be adequate in a brand catalogue but insufficient for a legal-entity identity proposition in a compliance context."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ExampleContinuitySupportConstraint",
      "@type": "arc:IllustrativeConstraint",
      "schema:name": "Illustrative continuity-support requirement",
      "schema:description": "An example domain constraint: documented, temporally applicable evidence may establish that distinct records refer to one continuing entity."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#MutationClass",
      "@type": "arc:OperationClass",
      "schema:name": "Protected mutation class",
      "schema:description": "The operation/effect class used to determine whether a proposed action can alter shared identity interpretation and which propositions are required."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ProposedMutation",
      "@type": "arc:Operation",
      "schema:name": "Proposed mutation m",
      "schema:description": "A proposed operation with a declared target and effect scope; potentially protected when it can alter shared identity interpretation."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#RequiredPropositionSet",
      "@type": "arc:ClaimSet",
      "schema:name": "Required proposition set q_m",
      "schema:description": "The mutation-specific identity or continuity proposition set derived by the Supervisor from the mutation and applicable versioned policy."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#AuthorizationRecord",
      "@type": "arc:AuthorizationRecord",
      "schema:name": "Authorization record α_m",
      "schema:description": "A record binding the derived proposition set to the proposed operation, target/effect scope, applicable policy version, and action-specific state versions. A REVERSIBLE_WRITE additionally binds the shadow version and any separately versioned staging-isolation state relevant to the action."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#EvidenceObservation",
      "@type": "arc:EvidenceItem",
      "schema:name": "Retrieved evidence observation",
      "schema:description": "An observation returned by a retrieval or tool action before it is admitted to a shared evidence set."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#QuarantineEvidence",
      "@type": "arc:EvidenceSet",
      "schema:name": "Quarantined evidence P_quar",
      "schema:description": "Evidence retained outside the Planner-visible active set pending admission or adjudication."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#AdmissionConflictCheck",
      "@type": "arc:Process",
      "schema:name": "Evidence-admission conflict check",
      "schema:description": "A mutation-independent evidence-admission check, distinct from the claim-specific conflict check used to evaluate a proposed mutation. It does not depend on mutation-specific q_m; conflict or indeterminate results retain evidence in quarantine."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ActiveEvidenceSet",
      "@type": "arc:EvidenceSet",
      "schema:name": "Planner-visible active evidence P_active",
      "schema:description": "The evidence set available to the Planner; it may contain UNVERIFIED observations and can expose unresolved conflict indications, but does not itself provide positive authorization support. Claim-specific P_auth is an eligibility subset of this admitted set, not a separate physical store."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#UnverifiedStatus",
      "@type": "arc:EvidenceStatus",
      "schema:name": "UNVERIFIED evidence status",
      "schema:description": "An admission-level status meaning claim-specific eligibility has not been established for the proposition under assessment; it is not a universal truth or falsity label."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ClaimSpecificPromotion",
      "@type": "arc:Process",
      "schema:name": "Claim-specific evidence promotion",
      "schema:description": "A separate, auditable assessment of an evidence item's role and eligibility for a particular proposition, observation domain, temporal applicability, and declared policy."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#AuthorizationEligibleEvidenceSet",
      "@type": "arc:EvidenceSet",
      "schema:name": "Claim-specific authorization-eligible evidence P_auth(q_m, ω)",
      "schema:description": "A proposition- and context-specific eligibility subset of P_active, not a separate physical repository; recorded roles can include support, contradiction, or unresolved indication."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#SupportRole",
      "@type": "arc:EvidenceRole",
      "schema:name": "Positive claim-support role",
      "schema:description": "A recorded evidentiary role that can satisfy a required positive proposition when its validation basis and applicability meet the declared policy."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ContradictionRole",
      "@type": "arc:EvidenceRole",
      "schema:name": "Claim-specific contradiction role",
      "schema:description": "A recorded evidentiary role that may establish a relevant contradiction or policy prohibition for a specific proposition."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#UnresolvedIndicationRole",
      "@type": "arc:EvidenceRole",
      "schema:name": "Unresolved material-conflict indication",
      "schema:description": "A recorded role indicating a possible material conflict that remains unresolved or indeterminate and therefore prevents PASS."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#Phase1Authorization",
      "@type": "arc:SupervisorPhase",
      "schema:name": "Phase 1 — pre-execution authorization",
      "schema:description": "The Supervisor's pre-execution evaluation of the proposed operation, action class, required propositions, claim-specific evidence, conflicts, scope, policy, and action-relevant versions. READ, STAGE_LOCAL, REVERSIBLE_WRITE, and IRREVERSIBLE_WRITE have distinct authorization paths."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#Phase2Validation",
      "@type": "arc:SupervisorPhase",
      "schema:name": "Phase 2 — post-execution candidate validation",
      "schema:description": "The Supervisor's post-execution validation of the realized operation. It confirms no shared effects for STAGE_LOCAL, validates isolated and version-bound staging for REVERSIBLE_WRITE, and validates protected candidate graph mutations against claim-specific evidence, conflicts, scope, and a consistent snapshot."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#CandidateGraph",
      "@type": "arc:GraphState",
      "schema:name": "Candidate graph G_cand",
      "schema:description": "The isolated candidate graph resulting from the proposed mutation and evaluated before it can affect persistent shared identity state."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#CommitSnapshot",
      "@type": "arc:Snapshot",
      "schema:name": "Consistent commit-time snapshot σ_c",
      "schema:description": "The consistent snapshot of the relevant production graph, active/quarantined evidence, eligibility state, policy, optional shadow store, and their versions. It also includes staging-isolation state and its version when a REVERSIBLE_WRITE is evaluated and that state is separately versioned."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ProtectedCommitBoundary",
      "@type": "arc:EnforcementBoundary",
      "schema:name": "Protected commit boundary",
      "schema:description": "The enforcement boundary at which a persistent identity-changing mutation is admitted only if the commit invariant, scope, and version conditions pass."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#CommitInvariant",
      "@type": "arc:Invariant",
      "schema:name": "Commit invariant",
      "schema:description": "The interface invariant requiring EvaluateGraphConstraints=PASS, valid authorized scope, and valid bound versions at the commit point."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ScopeValidity",
      "@type": "arc:AuthorizationCondition",
      "schema:name": "Scope validity",
      "schema:description": "The condition that the realized operation, target, and effects remain within the authorization record's bound scope."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#VersionValidity",
      "@type": "arc:ConsistencyCondition",
      "schema:name": "Version integrity",
      "schema:description": "The condition that graph, complete evidence state, policy, optional shadow state, and any separately versioned staging-isolation state bound to the action remain valid at the required atomic linearization or commit point."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#OutcomePASS",
      "@type": "arc:EvaluationOutcome",
      "schema:name": "PASS",
      "schema:description": "The evaluation outcome indicating that required positive conditions have claim-specific support, no applicable prohibition is established, and conflict status is CLEAR."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#OutcomeBREACH",
      "@type": "arc:EvaluationOutcome",
      "schema:name": "BREACH",
      "schema:description": "The evaluation outcome indicating an established relevant contradiction or explicit prohibitive-constraint violation; the candidate is rejected/escalated."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#OutcomeUNKNOWN",
      "@type": "arc:EvaluationOutcome",
      "schema:name": "UNKNOWN_EVIDENCE",
      "schema:description": "The evaluation outcome indicating insufficient positive support or an unresolved/indeterminate material conflict; the protected mutation is deferred."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#AssumptionsSet",
      "@type": "arc:AssumptionSet",
      "schema:name": "Assumptions 1–7",
      "schema:description": "Seven stated conditions with distinct roles: fail-closed outcome semantics, enforcement premises, and evidence/policy adequacy conditions."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#Assumption1",
      "@type": "arc:Assumption",
      "schema:name": "Assumption 1 — domain-policy adequacy",
      "schema:description": "V_E expresses relevant identity-preserving constraints for the entity class, context, time, and mutation type."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#Assumption2",
      "@type": "arc:Assumption",
      "schema:name": "Assumption 2 — claim-specific promotion correctness",
      "schema:description": "Evidence enters P_auth only when the promotion process correctly applies the declared claim-specific policy and contract."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#Assumption3",
      "@type": "arc:Assumption",
      "schema:name": "Assumption 3 — fail-closed authorization",
      "schema:description": "Insufficient evidence or an unresolved material conflict does not authorize an irreversible identity change."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#Assumption4",
      "@type": "arc:Assumption",
      "schema:name": "Assumption 4 — enforced and conservative mutation classification",
      "schema:description": "Every relevant production write passes through the Supervisor and any operation that may alter shared identity interpretation is treated as protected."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#Assumption5",
      "@type": "arc:Assumption",
      "schema:name": "Assumption 5 — Supervisor-derived authorization propositions",
      "schema:description": "The Supervisor derives q_m from the mutation, target/effect scope, and versioned policy; the Planner cannot replace or weaken it."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#Assumption6",
      "@type": "arc:Assumption",
      "schema:name": "Assumption 6 — scope and version integrity",
      "schema:description": "The authorized operation/scope and all action-relevant graph, evidence, policy, optional shadow, and separately versioned staging-isolation state remain valid through the applicable linearization or commit point."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#Assumption7",
      "@type": "arc:Assumption",
      "schema:name": "Assumption 7 — recorded-basis and eligibility integrity",
      "schema:description": "The promotion process controls eligibility metadata and applies provenance restrictions to the recorded basis; unrecorded derivations remain outside the guarantee."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ConditionalGuarantee",
      "@type": "arc:Guarantee",
      "schema:name": "Conditional commit-boundary guarantee",
      "schema:description": "The protected commit property stated by the interface invariant, conditional on Assumptions 1–7; it is not a theorem of semantic correctness."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#EvaluationProtocol",
      "@type": "arc:EvaluationDesign",
      "schema:name": "Proposed evaluation protocol",
      "schema:description": "A prospective comparative evaluation using independently constructed cases, common outcome adjudication, matched controls, an explicit decision rule, and author-team-aware uncertainty; no experimental results are claimed."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#BaselineA",
      "@type": "arc:EvaluationCondition",
      "schema:name": "Baseline A — unconstrained Agentic ER",
      "schema:description": "An Agentic ER condition without the proposed mutation-authorization boundary."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#BaselineB",
      "@type": "arc:EvaluationCondition",
      "schema:name": "Baseline B — conventional identifier/default-deny rules",
      "schema:description": "A condition using conventional identifier constraints and abstention when required evidence is missing."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#BaselineC",
      "@type": "arc:EvaluationCondition",
      "schema:name": "Baseline C — generic authorization boundary",
      "schema:description": "A generic two-phase mutation gate with claim-specific evidence separation but policy rules authored without the DIO/ODI diagnostic mapping."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#Challenger",
      "@type": "arc:EvaluationCondition",
      "schema:name": "Challenger — DIO/ODI-informed guardrail",
      "schema:description": "The same gate and controlled resources as Baseline C, with shared domain facts organized through the DIO/ODI diagnostic-to-constraint mapping."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#PolicyAuthoringTeams",
      "@type": "arc:EvaluationControl",
      "schema:name": "Independent policy-authoring teams",
      "schema:description": "Independently constituted authoring teams used to reduce team-specific policy-authoring skill as a confound in the Baseline C–Challenger comparison."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#CaseInventory",
      "@type": "arc:EvaluationControl",
      "schema:name": "Shared case inventory",
      "schema:description": "The same prespecified cases and splits used for Baseline C and Challenger."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#DomainFactInventory",
      "@type": "arc:EvaluationControl",
      "schema:name": "Shared domain-fact inventory",
      "schema:description": "The same underlying domain-fact annotations are available to both compared conditions."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#EvidencePromotionProcess",
      "@type": "arc:EvaluationControl",
      "schema:name": "Shared evidence-promotion process",
      "schema:description": "The same claim-specific promotion process is used in Baseline C and Challenger so its quality is not the treatment contrast."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ValidatorClass",
      "@type": "arc:EvaluationControl",
      "schema:name": "Matched validator class",
      "schema:description": "The same validator class and configuration are used in Baseline C and Challenger; policy-derived q_m differences are reported because they are part of the intended policy-organization pathway."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ActionResourceBudget",
      "@type": "arc:EvaluationControl",
      "schema:name": "Matched action resources",
      "schema:description": "The compared conditions receive matched action/tool resources."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#DecisionBudget",
      "@type": "arc:EvaluationControl",
      "schema:name": "Matched decision budget",
      "schema:description": "The compared conditions receive a matched decision budget."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#PolicyAuthoringProtocol",
      "@type": "arc:EvaluationControl",
      "schema:name": "Policy-authoring and blinding protocol",
      "schema:description": "A prespecified protocol matches authoring effort and relevant expertise, prevents cross-condition policy leakage, and records whether replication across independent teams is performed."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#PrespecifiedDecisionMargins",
      "@type": "arc:EvaluationControl",
      "schema:name": "Prespecified decision margins δ_SRC and δ_RFCR",
      "schema:description": "Task- and policy-family-specific non-inferiority and materiality margins selected before outcomes are examined, with a prespecified uncertainty procedure."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#IndependentGroundTruth",
      "@type": "arc:EvaluationResource",
      "schema:name": "Independent ground-truth annotations",
      "schema:description": "Independent labels used to distinguish policy-permitted mutations from referential correctness and to calculate outcome metrics."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#IncrementalValueHypothesis",
      "@type": "arc:EvaluationHypothesis",
      "schema:name": "Incremental-value hypothesis for DIO/ODI mapping",
      "schema:description": "The empirical hypothesis that diagnostic organization and its explicit constraint mapping improve the safety/coverage trade-off beyond a matched generic authorization boundary."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#DependencyAwareEvidenceFlow",
      "@type": "arc:FutureResearch",
      "schema:name": "Dependency-aware evidence flow",
      "schema:description": "A possible future layer for recording hypothesis/action/query/observation/claim derivation lineage and controlling feedback into planning."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ObservationContext",
      "@type": "arc:PolicyScope",
      "schema:name": "Bound observation context ω",
      "schema:description": "The observation context fixed by the domain-policy instance bound through v_pol; it is not a free evaluation input."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#TargetEffectScope",
      "@type": "arc:AuthorizationScope",
      "schema:name": "Mutation target/effect scope",
      "schema:description": "The declared target and permitted effect scope supplied to mutation-specific required-claim derivation and bound in authorization."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#AuthorizationEligibilityState",
      "@type": "arc:EvidenceState",
      "schema:name": "Authorization-eligibility state",
      "schema:description": "The versioned state of proposition- and context-specific promotion eligibility. The Planner and raw tool outputs cannot directly set or alter this state; only the designated claim-specific promotion process or a versioned policy/adjudication operation may change it."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#GraphVersion",
      "@type": "arc:StateVersion",
      "schema:name": "Graph version v_G",
      "schema:description": "The graph-state version bound for a protected mutation and revalidated atomically at commit."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#EvidenceStateVersion",
      "@type": "arc:StateVersion",
      "schema:name": "Evidence-state version v_E",
      "schema:description": "One version covering P_active, P_quar, and authorization-eligibility changes, including admission, adjudication, promotion, demotion, and revocation."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#PolicyVersion",
      "@type": "arc:StateVersion",
      "schema:name": "Domain-policy version v_pol",
      "schema:description": "The version of the domain-policy instance that fixes applicable constraints, observation context, temporal conditions, and required-claim derivation."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ShadowVersion",
      "@type": "arc:StateVersion",
      "schema:name": "Shadow-state version v_S",
      "schema:description": "The version of isolated shadow state when a shadow layer is used and bound to the relevant action."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#PromotionValidationRecord",
      "@type": "arc:EvidenceRecord",
      "schema:name": "Promotion/validation record identifier",
      "schema:description": "A stable identifier for the claim-specific promotion and validation basis relied on for each required proposition."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#SharedOriginIndependenceRule",
      "@type": "arc:PromotionConstraint",
      "schema:name": "Recorded shared-origin independence restriction",
      "schema:description": "A promotion restriction that prevents observations with recorded shared upstream query, hypothesis, source, or derivation origins from being counted as independent corroboration merely because they are separate items."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ShadowLineageExclusionRule",
      "@type": "arc:PromotionConstraint",
      "schema:name": "Recorded shadow-lineage exclusion",
      "schema:description": "A promotion restriction excluding a shadow candidate and recorded claims transitively based on shadow content from positive authorization support."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#AdmissionConflictOutcome",
      "@type": "arc:OutcomeSet",
      "schema:name": "Admission conflict outcome",
      "schema:description": "A mutation-independent admission result distinguishing conflict, no conflict detected, and indeterminate; no-conflict-detected is not positive identity evidence."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#AdmissionConflict",
      "@type": "arc:AdmissionOutcome",
      "schema:name": "CONFLICT admission result",
      "schema:description": "A supported material conflict that retains the observation in quarantine."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#AdmissionNoConflictDetected",
      "@type": "arc:AdmissionOutcome",
      "schema:name": "NO_CONFLICT_DETECTED admission result",
      "schema:description": "The admission check did not establish a conflict; this is not a guarantee that all conflicts are absent and is not positive identity evidence."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#AdmissionIndeterminate",
      "@type": "arc:AdmissionOutcome",
      "schema:name": "INDETERMINATE admission result",
      "schema:description": "A plausible material conflict that cannot be resolved on the available admission basis and therefore retains the observation in quarantine."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#StatusPrecedenceRule",
      "@type": "arc:EvaluationRule",
      "schema:name": "Evaluation-status precedence rule",
      "schema:description": "The required aggregation order BREACH before UNKNOWN_EVIDENCE before PASS."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#HumanAdjudicationBranch",
      "@type": "arc:ControlBranch",
      "schema:name": "Policy-conditioned human-adjudication branch",
      "schema:description": "A conditional UNKNOWN_EVIDENCE path to human adjudication only when policy requires it and a reviewer is available."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#FreshAuthorizationDecision",
      "@type": "arc:AuthorizationDecision",
      "schema:name": "Fresh authorization decision",
      "schema:description": "A new authorization evaluation against current evidence, policy, graph, and relevant state versions after human adjudication changes case disposition."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#CommonRetryBudget",
      "@type": "arc:ResourceControl",
      "schema:name": "Common retry budget",
      "schema:description": "One retry budget shared across stale-snapshot, graph/evidence/policy/shadow version conflicts, separately versioned staging-isolation-state conflicts, and evidence-admission compare-and-swap retry triggers across the lifecycle."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#CorrectiveIdentityMutation",
      "@type": "arc:OperationClass",
      "schema:name": "Corrective split or un-merge mutation",
      "schema:description": "A protected identity-changing correction, including splitting or un-merging, with policy-defined propositions distinct from merge authorization."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#CommonEvaluationReference",
      "@type": "arc:EvaluationResource",
      "schema:name": "Common independent evaluation reference",
      "schema:description": "The condition-independent annotation reference for correctness, safety, admissibility, resolvability, and benignness used by SRC, UAR, and FPIR."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#IndependentCaseConstruction",
      "@type": "arc:EvaluationControl",
      "schema:name": "Independent case and stratum construction",
      "schema:description": "Construction or review of test cases and strata by a party outside both policy-authoring teams and without access to frozen condition policies."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#TaxonomyNeutralStratum",
      "@type": "arc:EvaluationControl",
      "schema:name": "Taxonomy-neutral evaluation stratum",
      "schema:description": "A stratum defined from observable case facts without DIO/ODI diagnostic labels, reported alongside diagnostic strata."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#OutcomeAdjudicators",
      "@type": "arc:EvaluationControl",
      "schema:name": "Independent outcome adjudicators",
      "schema:description": "Adjudicators independent of policy authors and masked to condition where practicable, applying the common evaluation reference."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#AuthorTeamAllocation",
      "@type": "arc:EvaluationControl",
      "schema:name": "Prespecified author-team allocation",
      "schema:description": "Random or expertise-blocked assignment of independent author teams to conditions for stronger comparative inference."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#PriorDIOExposureRecord",
      "@type": "arc:EvaluationControl",
      "schema:name": "Prior DIO/ODI exposure record",
      "schema:description": "A record of policy authors' prior exposure to DIO/ODI materials, used to assess possible contamination of the authoring contrast."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ValidatorConfiguration",
      "@type": "arc:EvaluationControl",
      "schema:name": "Matched validator configuration",
      "schema:description": "The validator configuration held constant across Baseline C and Challenger; policy-derived q_m differences are recorded rather than suppressed."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#OutcomeCountingCodebook",
      "@type": "arc:EvaluationControl",
      "schema:name": "Outcome counting codebook",
      "schema:description": "A prespecified codebook for unique operation attempts, retries, terminal case resolution, non-match outcomes, unknown outcomes, confusion-matrix mapping, and zero denominators."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#UniqueMutationAttempt",
      "@type": "arc:EvaluationUnit",
      "schema:name": "Unique protected mutation attempt",
      "schema:description": "A mutation intention identified by operation_id; retries and re-evaluations for the same operation_id count once."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#OutcomeCutoff",
      "@type": "arc:EvaluationControl",
      "schema:name": "Fixed outcome and reconciliation cutoff",
      "schema:description": "The prespecified observation-window endpoint at which terminal case and transaction outcomes are classified; unresolved transaction outcomes remain unknown."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#UndefinedRFCRBranch",
      "@type": "arc:DecisionRule",
      "schema:name": "Undefined-RFCR decision branch",
      "schema:description": "If RFCR is undefined in either condition, RFCR-based comparative routes are non-evaluable and do not establish safety superiority or inferiority."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#MultiplicityControlRule",
      "@type": "arc:EvaluationControl",
      "schema:name": "Two-route inference calibration",
      "schema:description": "The prespecified uncertainty procedure accounts for the alternative-route OR decision structure and calibrates the overall claim criterion, for example through simultaneous bounds or another justified multiplicity-control approach."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#AuthorTeamPerformanceContrast",
      "@type": "arc:EvaluationUnit",
      "schema:name": "Author-team-level performance contrast",
      "schema:description": "The primary aggregation target for stronger multi-team inference, respecting between-team variation rather than treating repeated runs as independent authoring replications."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#RequiredClaimDerivation",
      "@type": "arc:AuthorizationFunction",
      "schema:name": "Supervisor-side required-claim derivation",
      "schema:description": "The derivation operation that takes the proposed mutation, target/effect scope, configured constraints, and applicable policy version to produce q_m."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#TemporalApplicability",
      "@type": "arc:PolicyScope",
      "schema:name": "Temporal applicability scope",
      "schema:description": "The validity interval or temporal condition against which a claim or configured constraint is assessed where relevant."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified",
      "@type": "arc:EpistemicStatus",
      "schema:name": "specified",
      "schema:description": "Explicitly defined in the current conceptual architecture or interface specification."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/assumed",
      "@type": "arc:EpistemicStatus",
      "schema:name": "assumed",
      "schema:description": "Required for the conditional property but not independently established by the architecture."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/illustrative",
      "@type": "arc:EpistemicStatus",
      "schema:name": "illustrative",
      "schema:description": "A possible pathway or example, not asserted as universal or inevitable."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/proposed-evaluation",
      "@type": "arc:EpistemicStatus",
      "schema:name": "proposed evaluation",
      "schema:description": "A prospective evaluation element; no empirical result is asserted."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/future-research",
      "@type": "arc:EpistemicStatus",
      "schema:name": "future research",
      "schema:description": "A direction explicitly outside the current architecture."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/canonical-reference",
      "@type": "arc:EpistemicStatus",
      "schema:name": "canonical reference",
      "schema:description": "An existing canonical DIO/ODI concept referenced without redefining it."
    },
