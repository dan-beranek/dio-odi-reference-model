      },
      "rdf:object": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ExampleTemporalApplicabilityConstraint"
      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/illustrative"
      },
      "arc:sourceSection": "§3; §5.2",
      "arc:interpretationNote": "The example binds rename or continuity claims to the relevant referent and validity interval.",
      "dcterms:source": {
