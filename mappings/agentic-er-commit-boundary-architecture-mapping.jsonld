      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified"
      },
      "arc:sourceSection": "§5.3; §5.4",
      "arc:interpretationNote": "Claim-specific authorization-eligible evidence can establish a relevant contradiction or policy-prohibitive condition.",
      "dcterms:source": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55"
      }
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R188",
      "@type": [
        "arc:RelationAssertion",
        "rdf:Statement"
      ],
      "rdf:subject": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ClaimConflictCheck"
      },
      "rdf:predicate": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assesses"
      },
      "rdf:object": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ActiveEvidenceSet"
      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified"
      },
      "arc:sourceSection": "§5.3; §5.4",
      "arc:interpretationNote": "UNVERIFIED material in P_active can indicate a possible material conflict and produce INDETERMINATE, but cannot itself establish mutation-level BREACH or positive support.",
      "dcterms:source": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55"
      }
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R189",
      "@type": [
        "arc:RelationAssertion",
        "rdf:Statement"
      ],
      "rdf:subject": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ClaimConflictCheck"
      },
      "rdf:predicate": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assesses"
      },
      "rdf:object": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#QuarantineEvidence"
      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified"
      },
      "arc:sourceSection": "§5.3; §5.4",
      "arc:interpretationNote": "Materially relevant quarantined evidence can indicate an unresolved conflict and therefore prevent PASS.",
      "dcterms:source": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55"
      }
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R190",
      "@type": [
        "arc:RelationAssertion",
        "rdf:Statement"
      ],
      "rdf:subject": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ClaimConflictCheck"
      },
      "rdf:predicate": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#returns"
      },
      "rdf:object": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ClaimConflictClear"
      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified"
      },
      "arc:sourceSection": "§5.3; §5.4",
      "arc:interpretationNote": "CLEAR is returned only when no unresolved material conflict bearing on q_m is detected in the checked evidence state.",
      "dcterms:source": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55"
      }
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R191",
      "@type": [
        "arc:RelationAssertion",
        "rdf:Statement"
      ],
      "rdf:subject": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ClaimConflictCheck"
      },
      "rdf:predicate": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#returns"
      },
      "rdf:object": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ClaimConflictDetected"
      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified"
      },
      "arc:sourceSection": "§5.3; §5.4",
      "arc:interpretationNote": "CONFLICT is returned only when claim-specific authorization-eligible evidence establishes a relevant contradiction or prohibitive condition.",
      "dcterms:source": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55"
      }
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R192",
      "@type": [
        "arc:RelationAssertion",
        "rdf:Statement"
      ],
      "rdf:subject": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ClaimConflictCheck"
      },
      "rdf:predicate": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#returns"
      },
      "rdf:object": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ClaimConflictIndeterminate"
      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified"
      },
      "arc:sourceSection": "§5.3; §5.4",
      "arc:interpretationNote": "INDETERMINATE is returned when a possible conflict is indicated by UNVERIFIED or quarantined evidence, or conflicting eligible items cannot be reconciled under policy.",
      "dcterms:source": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55"
      }
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R193",
      "@type": [
        "arc:RelationAssertion",
        "rdf:Statement"
      ],
      "rdf:subject": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ClaimConflictClear"
      },
      "rdf:predicate": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#permitsPassOnlyWithOtherRequirementsSatisfied"
      },
      "rdf:object": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#OutcomePASS"
      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified"
      },
      "arc:sourceSection": "§5.3; §5.4",
      "arc:interpretationNote": "CLEAR is necessary but not sufficient for PASS; positive support, constraints, scope, and versions must also pass.",
      "dcterms:source": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55"
      }
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R194",
      "@type": [
        "arc:RelationAssertion",
        "rdf:Statement"
      ],
      "rdf:subject": {
