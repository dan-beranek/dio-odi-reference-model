      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/illustrative"
      },
      "arc:sourceSection": "§3; §5.2",
      "arc:interpretationNote": "The example rejects lexical similarity or commercial adjacency as sufficient proof of co-reference; the actual evidentiary rule remains domain-configured.",
      "dcterms:source": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55"
      }
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R082",
      "@type": [
        "arc:RelationAssertion",
        "rdf:Statement"
      ],
      "rdf:subject": {
        "@id": "https://vocab.danielberanek.cz/dio-odi/#MergeFailure"
      },
      "rdf:predicate": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#mapsIllustrativelyTo"
      },
      "rdf:object": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ExampleReferentCoreferenceConstraint"
      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/illustrative"
      },
      "arc:sourceSection": "§3; §5.2",
      "arc:interpretationNote": "The example requires claim-specific co-reference support before merging distinct records; it is not a universal fixed predicate. The same protected boundary applies to corrective splits and un-merges under mutation-specific policy claims.",
      "dcterms:source": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55"
      }
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R083",
