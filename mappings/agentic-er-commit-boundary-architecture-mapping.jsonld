        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified"
      },
      "arc:sourceSection": "§5.3; §5.4",
      "arc:interpretationNote": "A possible or unreconciled material conflict is UNKNOWN_EVIDENCE rather than a semantic verdict that the identity claim is false.",
      "dcterms:source": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55"
      }
    },
    {
