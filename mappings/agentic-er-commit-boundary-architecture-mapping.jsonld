      "rdf:object": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ExampleContinuitySupportConstraint"
      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/illustrative"
      },
      "arc:sourceSection": "§3; §5.2",
      "arc:interpretationNote": "The paper also gives a positive continuity case: distinct records may be resolved when documented, temporally applicable evidence supports one continuing referent.",
      "dcterms:source": {
