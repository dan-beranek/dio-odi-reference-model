      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified"
      },
      "arc:sourceSection": "§5.3; §6.1",
      "arc:interpretationNote": "A recorded disposition decision advances v_E because the relevant evidence state has changed.",
      "dcterms:source": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55"
      }
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R200",
      "@type": [
        "arc:RelationAssertion",
        "rdf:Statement"
      ],
      "rdf:subject": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#QuarantineDispositionDecision"
      },
      "rdf:predicate": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#requiresReadmissionThrough"
      },
