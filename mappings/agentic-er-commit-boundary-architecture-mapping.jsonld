      },
      "arc:sourceSection": "§8.2",
      "arc:interpretationNote": "The overall inference procedure accounts for the two-route OR decision structure when calibrating uncertainty and the claim criterion.",
      "dcterms:source": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55"
      }
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ReadAction",
      "@type": "arc:OperationClass",
      "schema:name": "READ",
      "schema:description": "Retrieval or exploration within a declared scope. Its authorization is scope/policy-bound but does not pre-bind unrelated graph or evidence versions that would force replay of the retrieval; the returned observation is admitted against the current evidence state."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#StageLocalAction",
      "@type": "arc:OperationClass",
      "schema:name": "STAGE_LOCAL",
      "schema:description": "Local preparation with no shared-state effects. Its authorization binds local dependency versions only when the declared operation explicitly depends on them; post-execution validation confirms that no shared-state effects occurred."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ReversibleWriteAction",
      "@type": "arc:OperationClass",
      "schema:name": "REVERSIBLE_WRITE",
      "schema:description": "A provisional write authorized only to an isolated staging target such as G_shadow. It must be positively shown to be separated from production identity state, Planner-visible shared identity state, downstream consumers, and P_auth inputs; it never authorizes publication to G_prod."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#IrreversibleWriteAction",
      "@type": "arc:OperationClass",
      "schema:name": "IRREVERSIBLE_WRITE",
      "schema:description": "The protected action class for operations whose realized or potential shared effects can persistently alter identity interpretation. Ambiguous classification or unverifiable staging isolation is handled through this protected path."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ProductionGraph",
      "@type": "arc:GraphState",
      "schema:name": "Production graph G_prod",
      "schema:description": "The persistent shared graph whose identity interpretation must not be affected by a REVERSIBLE_WRITE."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ShadowGraph",
      "@type": "arc:GraphState",
      "schema:name": "Isolated shadow graph G_shadow",
      "schema:description": "A staging target for an explicitly authorized REVERSIBLE_WRITE. Staging there is provisional and does not authorize publication to the production graph."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#StagingIsolationState",
      "@type": "arc:IsolationState",
      "schema:name": "Staging-isolation state",
      "schema:description": "The separately represented state describing whether a staging target is isolated from production identity state, Planner-visible shared identity state, downstream consumers, and all P_auth inputs. It is included in the relevant snapshot for REVERSIBLE_WRITE evaluation."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#StagingIsolationVersion",
      "@type": "arc:StateVersion",
      "schema:name": "Separately represented staging-isolation-state version",
      "schema:description": "An optional version identifier for staging-isolation state when that state is separately versioned. The manuscript requires any such relevant version to be bound and revalidated but does not prescribe a dedicated symbol."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#LocalDependencyVersion",
      "@type": "arc:StateVersion",
      "schema:name": "Action-bound local dependency version",
      "schema:description": "A version of a local dependency explicitly bound when a STAGE_LOCAL operation depends on it. Shared-state versions are not required for that action unless the operation explicitly depends on them."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#PlannerVisibleSharedIdentityState",
      "@type": "arc:EvidenceState",
      "schema:name": "Planner-visible shared identity state",
      "schema:description": "Shared identity-related state visible to the Planner, from which a REVERSIBLE_WRITE must remain isolated."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#DownstreamConsumers",
      "@type": "arc:Component",
      "schema:name": "Downstream consumers",
      "schema:description": "External or downstream consumers that must not observe effects of a provisional REVERSIBLE_WRITE before a protected production mutation is separately authorized."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ClaimConflictCheck",
      "@type": "arc:Process",
      "schema:name": "Claim-specific conflict check",
      "schema:description": "A mutation-specific CheckClaimConflict(q_m, P_auth, P_active, P_quar), distinct from the mutation-independent evidence-admission check. It determines whether material conflict bearing on the required propositions is clear, established, or indeterminate."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ClaimConflictClear",
      "@type": "arc:ClaimConflictOutcome",
      "schema:name": "CLEAR",
      "schema:description": "No unresolved material conflict bearing on the required propositions is detected in the checked evidence state. CLEAR is a necessary conflict condition for PASS, not proof that unobserved conflicts do not exist."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ClaimConflictDetected",
      "@type": "arc:ClaimConflictOutcome",
      "schema:name": "CONFLICT",
      "schema:description": "Claim-specific authorization-eligible evidence establishes a relevant contradiction or policy-prohibitive condition for a required proposition."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ClaimConflictIndeterminate",
      "@type": "arc:ClaimConflictOutcome",
      "schema:name": "INDETERMINATE",
      "schema:description": "A possible material conflict is indicated only by UNVERIFIED or quarantined evidence, or by authorization-eligible items that cannot be reconciled under applicable authority and temporal rules."
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#QuarantineDispositionDecision",
      "@type": "arc:Process",
      "schema:name": "Quarantine disposition under policy/adjudication",
      "schema:description": "A mapping label for the policy-designated adjudication or versioned-rule decision that changes a quarantined item's disposition. The decision is recorded, advances evidence-state version, and requires a fresh admission check before release; release to P_active confers only UNVERIFIED status, not claim-specific eligibility."
    },
    {
