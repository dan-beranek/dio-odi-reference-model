      },
      "rdf:predicate": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#separatesContractComplianceFrom"
      },
      "rdf:object": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#CommonEvaluationReference"
      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/proposed-evaluation"
      },
      "arc:sourceSection": "§8.1; §8.2",
      "arc:interpretationNote": "PEVR uses each condition's operational contract; SRC, UAR, and FPIR use the common independent reference.",
      "dcterms:source": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55"
      }
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R153",
      "@type": [
        "arc:RelationAssertion",
