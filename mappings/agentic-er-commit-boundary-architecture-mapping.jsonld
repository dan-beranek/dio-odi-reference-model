      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/illustrative"
      },
      "arc:sourceSection": "§3; §5.2",
      "arc:interpretationNote": "The example makes temporal applicability part of the mutation-specific authorization assessment.",
      "dcterms:source": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55"
      }
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R085",
      "@type": [
        "arc:RelationAssertion",
        "rdf:Statement"
      ],
      "rdf:subject": {
        "@id": "https://vocab.danielberanek.cz/dio-odi/#SemanticFragmentation"
      },
      "rdf:predicate": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#mapsIllustrativelyTo"
      },
      "rdf:object": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ExampleMaterialConflictRetentionConstraint"
      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/illustrative"
      },
      "arc:sourceSection": "§3; §5.2",
      "arc:interpretationNote": "The mapping covers the identity-affecting subset of Semantic Fragmentation: materially incompatible identity-related claims remain unresolved until reconciled; other attribute-level incompatibilities remain governed by domain policy.",
      "dcterms:source": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55"
      }
    },
    {
