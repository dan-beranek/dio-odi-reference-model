      "@type": "schema:CreativeWork",
      "schema:name": "Constraining the Commit Boundary: A DIO/ODI-Informed Authorization Guardrail for Agentic Entity Resolution",
      "schema:version": "55 (production manuscript)",
      "schema:dateModified": "2026-11-04",
      "schema:encodingFormat": "text/markdown",
