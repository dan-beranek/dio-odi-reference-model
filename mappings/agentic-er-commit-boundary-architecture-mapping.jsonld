      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified"
      },
      "arc:sourceSection": "§5.3",
      "arc:interpretationNote": "Release to P_active confers only UNVERIFIED status; it does not confer claim-specific authorization eligibility.",
      "dcterms:source": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55"
      }
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R202",
      "@type": [
        "arc:RelationAssertion",
        "rdf:Statement"
      ],
      "rdf:subject": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#QuarantineDispositionDecision"
      },
      "rdf:predicate": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#doesNotDirectlyPromoteInto"
      },
      "rdf:object": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#AuthorizationEligibleEvidenceSet"
      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified"
      },
      "arc:sourceSection": "§5.3",
      "arc:interpretationNote": "Quarantine disposition is not claim-specific promotion; separate promotion is required for any P_auth eligibility.",
      "dcterms:source": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55"
      }
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R203",
      "@type": [
        "arc:RelationAssertion",
        "rdf:Statement"
      ],
      "rdf:subject": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#AuthorizationEligibilityState"
      },
      "rdf:predicate": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#mayBeChangedOnlyThrough"
      },
      "rdf:object": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#ClaimSpecificPromotion"
      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified"
      },
      "arc:sourceSection": "§5.3; §6.1",
      "arc:interpretationNote": "Eligibility metadata may be written or changed by the designated claim-specific promotion process.",
      "dcterms:source": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55"
      }
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R204",
      "@type": [
        "arc:RelationAssertion",
        "rdf:Statement"
      ],
      "rdf:subject": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#QuarantineDispositionDecision"
      },
      "rdf:predicate": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#doesNotDirectlyChangeEligibility"
      },
      "rdf:object": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#AuthorizationEligibilityState"
      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/specified"
      },
      "arc:sourceSection": "§5.3; §6.1",
      "arc:interpretationNote": "A quarantine-disposition decision that releases an item to P_active confers only UNVERIFIED status and does not itself change claim-specific authorization eligibility; any separate versioned policy/adjudication change to eligibility must trigger a fresh authorization decision.",
      "dcterms:source": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55"
      }
    },
    {
