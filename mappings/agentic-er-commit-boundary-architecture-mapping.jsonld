        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#OutcomeAdjudicators"
      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/proposed-evaluation"
      },
      "arc:sourceSection": "§8.1",
      "arc:interpretationNote": "Outcome adjudicators are independent of policy authors and masked to condition where practicable.",
      "dcterms:source": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#source/constraining_the_commit_boundary_v55"
      }
    },
    {
      "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#assertion/R152",
      "@type": [
        "arc:RelationAssertion",
        "rdf:Statement"
      ],
      "rdf:subject": {
