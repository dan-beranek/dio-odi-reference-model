      },
      "rdf:object": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#AuthorTeamPerformanceContrast"
      },
      "arc:epistemicStatus": {
        "@id": "https://vocab.danielberanek.cz/mappings/agentic-er-architecture/#status/proposed-evaluation"
      },
      "arc:sourceSection": "§8.1; §8.2",
      "arc:interpretationNote": "Stronger inference reflects between-team variation; repeated runs of one policy do not count as independent teams.",
      "dcterms:source": {
