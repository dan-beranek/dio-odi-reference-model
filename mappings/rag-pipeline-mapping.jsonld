  "hasPart": {
    "@type": "ItemList",
    "name": "DIO Reconstruction Failure Modes mapped to generic RAG loci",
    "numberOfItems": 8,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "CreativeWork",
          "name": "Entity Substitution",
          "url": "https://vocab.danielberanek.cz/dio-odi/#EntitySubstitution",
          "description": "Typical RAG loci: query interpretation, entity linking, retrieval, and synthesis. The intended referent is reconstructed as another distinct referent."
        }
      },
      {
        "@type": "ListItem",
        "position": 2,
        "item": {
          "@type": "CreativeWork",
          "name": "Merge Failure",
          "url": "https://vocab.danielberanek.cz/dio-odi/#MergeFailure",
          "description": "Typical RAG loci: indexing or entity linking, retrieval, context assembly, and synthesis. Distinct referents are reconstructed as a single referential identity."
        }
      },
      {
        "@type": "ListItem",
        "position": 3,
        "item": {
          "@type": "CreativeWork",
          "name": "Split Failure",
          "url": "https://vocab.danielberanek.cz/dio-odi/#SplitFailure",
          "description": "Typical RAG loci: indexing or entity linking, retrieval, and synthesis. Referential unity of one continuous entity is lost."
        }
      },
      {
        "@type": "ListItem",
        "position": 4,
        "item": {
          "@type": "CreativeWork",
          "name": "Entity Omission",
          "url": "https://vocab.danielberanek.cz/dio-odi/#EntityOmission",
          "description": "Typical RAG loci: post-retrieval context use, generation, and synthesis. No relevant reconstruction is produced despite sufficient representational grounds within the observation domain."
        }
      },
      {
        "@type": "ListItem",
        "position": 5,
        "item": {
          "@type": "CreativeWork",
          "name": "Semantic Fragmentation",
          "url": "https://vocab.danielberanek.cz/dio-odi/#SemanticFragmentation",
          "description": "Typical RAG loci: context assembly and synthesis. Referential unity remains while identity-preserving semantic coherence is lost."
        }
      },
      {
        "@type": "ListItem",
        "position": 6,
        "item": {
          "@type": "CreativeWork",
          "name": "Temporal Discontinuity",
          "url": "https://vocab.danielberanek.cz/dio-odi/#TemporalDiscontinuity",
          "description": "Typical RAG loci: indexing or version handling, retrieval, context assembly, and synthesis. Identity continuity across legitimate transformation is not preserved."
        }
      },
      {
        "@type": "ListItem",
        "position": 7,
        "item": {
          "@type": "CreativeWork",
          "name": "Temporal Misalignment",
          "url": "https://vocab.danielberanek.cz/dio-odi/#TemporalMisalignment",
          "description": "Typical RAG loci: retrieval, reranking, context assembly, and synthesis. The referent is correct but the reconstructed state is temporally inappropriate."
        }
      },
      {
        "@type": "ListItem",
        "position": 8,
        "item": {
          "@type": "CreativeWork",
          "name": "Contextual Displacement",
          "url": "https://vocab.danielberanek.cz/dio-odi/#ContextualDisplacement",
          "description": "Typical RAG loci: query interpretation, reranking, context assembly, and synthesis. A true reconstruction is contextually inadequate because a secondary identity aspect displaces the one relevant to the observation context."
        }
      }
    ]
  },
