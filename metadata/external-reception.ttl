<https://vocab.danielberanek.cz/external-reception/#bioregistry-dio-odi-prefix> a schema:CreativeWork ;
    dcterms:source <https://github.com/biopragmatics/bioregistry/commit/827f8c5c3c85615b8a4328d5f617a33bdc20fb9d>,
        <https://github.com/biopragmatics/bioregistry/issues/2182> ;
    schema:about <https://vocab.danielberanek.cz/dio-odi/#ReferenceVocabulary> ;
    schema:datePublished "2026-11-14"^^xsd:date ;
    schema:description "BioRegistry lists the DIO/ODI Reference Vocabulary under the prefix dio-odi. The record identifies a domain-independent SKOS ConceptScheme, links its canonical homepage and source repository, states the CC-BY-4.0 licence, and describes 40 concepts distributed in Turtle/SKOS and JSON-LD. This is an external registry and interoperability integration, not an independent scholarly review, citation, or endorsement."@en ;
    schema:genre "registry-interoperability" ;
    schema:name "DIO/ODI Reference Vocabulary — BioRegistry prefix record"@en ;
    schema:url <https://bioregistry.io/registry/dio-odi> .

<https://vocab.danielberanek.cz/external-reception/#semantic-farm-dio-odi-prefix> a schema:CreativeWork ;
    dcterms:source <https://semantic.farm/registry/dio-odi>,
        <https://semantic.farm/summary> ;
    schema:about <https://vocab.danielberanek.cz/dio-odi/#ReferenceVocabulary> ;
    schema:datePublished "2026-11-16"^^xsd:date ;
    schema:description "Semantic Farm registers the DIO/ODI Reference Vocabulary under the compact prefix dio-odi within a domain-agnostic semantic space registry, metaregistry, and compact identifier resolver. It places the vocabulary among resources spanning ontologies, controlled vocabularies, and other semantic spaces, and associates it with digital identity, knowledge organization, and semantic technologies. The record exposes identifier patterns and a resolvable CURIE example, links the canonical SKOS ConceptScheme and source repository, and makes registry data available in JSON, YAML, and RDF serializations including Turtle, JSON-LD, and N3. This is a substantive registry and interoperability integration, not a claim of scholarly peer review or endorsement."@en ;
    schema:genre "registry-interoperability" ;
    schema:name "DIO/ODI Reference Vocabulary — Semantic Farm registry record"@en ;
    schema:url <https://semantic.farm/registry/dio-odi> .

<https://vocab.danielberanek.cz/external-reception/#wren-castillo-entity-resolution-heterogeneous-sources> a schema:CreativeWork ;
    cito:cites <https://doi.org/10.5281/zenodo.22416026> ;
    schema:about <https://doi.org/10.5281/zenodo.22416026> ;
    schema:datePublished "2026-10-22"^^xsd:date ;
    schema:description "An external conceptual discussion of entity resolution across heterogeneous web sources, connected to identity collapse, semantic fragmentation, temporal discontinuity, and semantic vulnerability. Its research connection is The Crisis of Entity Resolution, not Commit Boundary."@en ;
