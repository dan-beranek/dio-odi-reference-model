<https://vocab.danielberanek.cz/external-reception/#unghost-agentic-er-loop-guardrail> a schema:CreativeWork ;
    cito:cites <https://arxiv.org/html/2610.37407v1> ;
    schema:about <https://arxiv.org/abs/2610.37407> ;
    schema:datePublished "2026-11-06"^^xsd:date ;
