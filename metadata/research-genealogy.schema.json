          },
          "profile_display_name": {
            "type": "string"
          },
          "collection_role": {
            "type": "string"
          },
          "content_scope": {
            "type": "string"
          },
          "attribution": {
            "type": "object",
            "required": [
              "status",
              "person_uri",
              "basis"
            ],
            "properties": {
              "status": {
                "type": "string"
              },
              "person_uri": {
                "type": "string",
                "format": "uri"
              },
              "basis": {
                "type": "string"
              }
            }
          },
          "curation_status": {
            "type": "string"
          },
          "representations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "platform",
                "url",
                "representation_type",
                "relation",
                "status"
              ],
              "properties": {
                "platform": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "representation_type": {
                  "type": "string"
                },
                "relation": {
                  "type": "string"
