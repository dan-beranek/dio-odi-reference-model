{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vocab.danielberanek.cz/metadata/research-genealogy.schema.json",
  "title": "DIO/ODI Research Genealogy Registry",
  "type": "object",
  "required": [
    "registry_version",
    "schema_version",
    "uri",
    "generated_on",
    "title",
    "description",
    "maintainer",
    "scope",
    "research_objects",
    "research_processes",
    "milestones",
    "source_collections",
    "artefacts",
    "inventory_leads",
    "relations",
    "research_clusters"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "uri": {
      "type": "string",
      "format": "uri"
    },
    "generated_on": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "maintainer": {
      "type": "object",
      "required": [
        "name",
        "person_uri",
        "orcid"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "person_uri": {
          "type": "string",
          "format": "uri"
        },
        "orcid": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "research_objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "uri",
          "object_type",
          "description",
          "components",
          "role_in_genealogy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "object_type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role_in_genealogy": {
            "type": "string"
          },
          "publication_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "publication_date_basis": {
            "type": "string"
          },
          "last_updated_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "last_updated_date_basis": {
            "type": "string"
          },
          "conceptual_themes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "theme",
                "description"
              ],
              "properties": {
                "theme": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "date_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title",
                "url",
                "role"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "role": {
                  "type": "string"
                }
              }
            }
          },
          "first_known_online_by": {
            "type": "string",
            "format": "date"
          },
          "first_known_online_basis": {
            "type": "string"
          },
          "earliest_archived_capture": {
            "type": "object",
            "required": [
              "captured_at",
              "archive",
              "url"
            ],
            "properties": {
              "captured_at": {
                "type": "string",
                "format": "date-time"
              },
              "archive": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "corroborating_archives": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "archive",
                "url",
                "captured_at",
                "role"
              ],
              "properties": {
                "archive": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "captured_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "role": {
                  "type": "string"
                }
              }
            }
          },
          "publication_records": {
            "type": "array",
            "description": "Bibliographic and repository pages that identify or expose the same underlying research object. Multiple records do not create multiple research outputs.",
            "items": {
              "type": "object",
              "required": [
                "record_type",
                "title",
                "url",
                "role"
              ],
              "properties": {
                "record_type": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "role": {
                  "type": "string"
                }
              }
            }
          },
          "identifiers": {
            "type": "array",
            "description": "Persistent identifiers associated with the research object. Identifiers are not separate research outputs.",
            "items": {
              "type": "object",
              "required": [
                "scheme",
                "value",
                "uri",
                "provider",
                "role"
              ],
              "properties": {
                "scheme": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "uri": {
                  "type": "string",
                  "format": "uri"
                },
                "provider": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "version_id": {
                  "type": "string",
                  "description": "Optional ID of the specific version identified by this persistent identifier."
                }
              }
            }
          },
          "institutional_record_status": {
            "type": "object",
            "description": "Availability of a public institutional or national thesis-catalogue page; absence may be recorded when author-confirmed.",
            "required": [
              "status",
              "basis",
              "note"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "public-record-available",
                  "no-public-record",
                  "not-assessed"
                ]
              },
              "basis": {
                "type": "string",
                "enum": [
                  "directly-verified",
                  "author-confirmed",
                  "not-assessed"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          },
          "versions": {
            "type": "array",
            "description": "Explicitly documented versions or successive submission attempts belonging to one research-object lineage.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "record_uri",
                "submission_attempt",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "record_uri": {
                  "type": "string",
                  "format": "uri"
                },
                "submission_attempt": {
                  "type": "integer",
                  "minimum": 1
                },
                "status": {
                  "type": "string"
                },
                "defended_on": {
                  "type": "string",
                  "format": "date"
                },
                "similarity_to_previous_version_percent": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "revision_extent_percent": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "doi": {
                  "type": "string"
                },
                "full_text_uri": {
                  "type": "string",
                  "format": "uri"
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "research_processes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "research_object_ids",
          "summary",
          "process_characteristics",
          "methods",
          "roles",
          "concept_outcomes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "temporal_scope": {
            "type": "object",
            "required": [
              "start",
              "end",
              "basis"
            ],
            "properties": {
              "start": {
                "type": "string",
                "format": "date"
              },
              "end": {
                "type": "string",
                "format": "date"
              },
              "basis": {
                "type": "string"
              }
            }
          },
          "research_object_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
          "process_characteristics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roles": {
            "type": "object"
          },
          "concept_outcomes": {
            "type": "array",
