              "type": "object",
              "required": [
                "id",
                "label",
                "uri",
                "articulated_on",
                "relation"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "uri": {
                  "type": "string",
                  "format": "uri"
                },
                "articulated_on": {
                  "type": "string",
                  "format": "date"
                },
                "relation": {
                  "type": "string"
                }
              }
            }
          },
          "subsequent_research": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "uri",
                "relation"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "uri": {
                  "type": "string",
                  "format": "uri"
                },
                "relation": {
                  "type": "string"
                }
              }
            }
          },
          "preceding_context_object_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "date",
          "date_basis",
          "title",
          "summary",
          "research_object_ids",
          "process_ids",
          "source"
