          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "date_end": {
            "type": "string",
            "format": "date"
          },
          "date_basis": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "research_object_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "process_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "concept_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "object",
            "required": [
              "title",
              "url"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    },
    "source_collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "platform",
          "title",
          "url",
          "collection_role",
