  "excluded_terms": [
    {
      "term": "digital entity",
      "reason": "Avoids reifying a separate 'digital entity'; DIO distinguishes the entity from its digital identity and distributed representations."
    },
    {
      "term": "machine-readable identity",
      "reason": "Redundant with the intended DIO sense of digital identity."
    },
    {
      "term": "machine interpretation",
      "reason": "Replaced by explicit reconstruction environments and the canonical Interpretation dimension where relevant."
    },
    {
      "term": "AI systems",
      "reason": "Prefer the stable term 'artificial intelligence' in the environment chunk."
    },
    {
      "term": "ontology engineering",
      "reason": "Would overstate the formal ontological status of the current Reference Model."
    },
    {
      "term": "identity graph",
      "reason": "Would overstate the artifact as a graph formalism rather than describe its actual metadata/reference function."
    },
    {
      "term": "semantic identity",
      "reason": "Avoids introducing a new quasi-canonical term not required by the corpus."
    },
    {
      "term": "entity reconstruction",
      "reason": "Avoids competing with the canonical phrase 'identity reconstruction'."
    }
  ]
