{
  "registry_version": "2.2.0",
  "status": "canonical-approved",
  "approved_on": "2026-10-25",
  "purpose": "Canonical ordered keyword grammar for the DIO/ODI corpus. It stabilizes lexical identity, preserves conceptual structure, and provides deterministic keyword projections for Zenodo and other metadata surfaces.",
  "principles": [
    "Keywords are an ordered metadata grammar, not an unordered bag of tags.",
    "Chunk order is invariant across the corpus.",
    "The identity invariant is always first.",
    "The reconstruction-environment block is always second.",
    "Within master chunks, selected terms retain the same relative order across works.",
    "K6 is exported as a complete ordered block or not exported at all.",
    "Work-specific positioning terms occupy C2 and may vary by work.",
    "Aliases support recognition but are not exported by default.",
    "Keyword assignment must not retroactively project concepts into a work that the work does not substantively carry."
  ],
  "export_policy": {
    "approved": true,
    "chunk_order": [
      "C0_identity_invariant",
      "C1_reconstruction_environments",
      "C2_work_positioning",
      "C3_reconstruction_mechanics",
      "C4_k6",
      "C5_failures_robustness",
      "C6_machine_readable_representation"
    ],
    "flattening_rule": "Concatenate active chunks in chunk_order; preserve term order inside each chunk; omit inactive terms; deduplicate case-insensitively without reordering.",
    "aliases_are_for_reconstruction_not_export": true
  },
