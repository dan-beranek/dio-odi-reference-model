@prefix dio-odi: <https://vocab.danielberanek.cz/dio-odi/#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <https://schema.org/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

dio-odi:ReferenceVocabulary a skos:ConceptScheme ;
  skos:prefLabel "DIO/ODI Reference Vocabulary"@en ;
  dcterms:title "DIO/ODI Reference Vocabulary"@en ;
  dcterms:creator <https://danielberanek.cz/#person> ;
  dcterms:isPartOf <https://doi.org/10.5281/zenodo.23272897> ;
  dcterms:description "SKOS reference vocabulary derived from the DIO/ODI corpus."@en ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  dcterms:issued "2026-11-05"^^xsd:date ;
  dcterms:modified "2026-11-09"^^xsd:date ;
  dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
  vann:preferredNamespacePrefix "dio-odi" ;
  vann:preferredNamespaceUri "https://vocab.danielberanek.cz/dio-odi/#" ;
  foaf:page <https://vocab.danielberanek.cz/dio-odi/> ;
  owl:versionInfo "0.2.2" ;
  skos:hasTopConcept dio-odi:ReconstructionFailureMode .

<https://danielberanek.cz/#person>
  a schema:Person, dcterms:Agent ;
  schema:name "Daniel Beránek" ;
  schema:url <https://danielberanek.cz/> ;
  schema:sameAs <https://orcid.org/0009-0004-0050-0264> .

dio-odi:DIO a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ;
  skos:prefLabel "Digital Identity Optimization"@en ;
  skos:altLabel "DIO"@en ;
  skos:definition "An applied discipline concerned with the intentional and systematic optimization of conditions under which an entity's digital identity is reconstructed by relevant human or machine observers."@en ;
  skos:related dio-odi:ODI, dio-odi:MVDIO ;
  dcterms:source <https://doi.org/10.5281/zenodo.21610934>, <https://doi.org/10.5281/zenodo.23226205> .

dio-odi:ODI a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ;
  skos:prefLabel "Ontology of Digital Identity"@en ;
  skos:altLabel "ODI"@en ;
  skos:definition "The theoretical meta-layer concerned with digital identity itself and the conditions of its existence, without requiring immediate practical optimization."@en ;
  skos:related dio-odi:DIO, dio-odi:SemanticField, dio-odi:K6 ;
  dcterms:source <https://doi.org/10.5281/zenodo.21610934> .

dio-odi:MVDIO a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ;
  skos:prefLabel "Minimum Viable Digital Identity Optimization"@en ;
  skos:altLabel "MVDIO"@en ;
  skos:definition "A coarse-grained analytical model identifying the minimum distinctions required for an optimizable problem of digital identity reconstruction to exist."@en ;
  skos:related dio-odi:DIO, dio-odi:K6, dio-odi:ReconstructionMechanism, dio-odi:DIOProblem, dio-odi:DIOIntervention ;
  dcterms:source <https://doi.org/10.5281/zenodo.23226205> .

dio-odi:SemanticField a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ;
  skos:prefLabel "Semantic Field"@en ;
  skos:definition "A modeled designation for the shared configuration of mutually conditioned analytical dimensions of digital identity; not a physical field or ontological substance."@en ;
  skos:related dio-odi:K6, dio-odi:ODI ;
  dcterms:source <https://danielberanek.cz/manifesto-of-digital-identity-optimization-dio-and-ontology-of-digital-identity-odi/>, <https://doi.org/10.5281/zenodo.23226205> .

dio-odi:K6 a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ;
  skos:prefLabel "K6 Semantic Connectome"@en ;
  skos:altLabel "Semantic Connectome"@en ;
  skos:definition "A finer-grained candidate model of digital identity comprising six analytically distinguishable dimensions within a single semantic field."@en ;
  skos:related dio-odi:SemanticField, dio-odi:MVDIO ;
  dcterms:hasPart dio-odi:EntityDimension, dio-odi:RepresentationDimension, dio-odi:InterpretationDimension, dio-odi:TrustDimension, dio-odi:RelationshipDimension, dio-odi:ReconstructionDimension ;
  dcterms:source <https://danielberanek.cz/manifesto-of-digital-identity-optimization-dio-and-ontology-of-digital-identity-odi/>, <https://doi.org/10.5281/zenodo.23226205> .

dio-odi:EntityDimension a skos:Concept ; skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Entity"@en ;
  dcterms:isPartOf dio-odi:K6 ; dcterms:source <https://danielberanek.cz/manifesto-of-digital-identity-optimization-dio-and-ontology-of-digital-identity-odi/> .
dio-odi:RepresentationDimension a skos:Concept ; skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Representation"@en ;
  dcterms:isPartOf dio-odi:K6 ; dcterms:source <https://danielberanek.cz/manifesto-of-digital-identity-optimization-dio-and-ontology-of-digital-identity-odi/> .
dio-odi:InterpretationDimension a skos:Concept ; skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Interpretation"@en ;
  dcterms:isPartOf dio-odi:K6 ; dcterms:source <https://danielberanek.cz/manifesto-of-digital-identity-optimization-dio-and-ontology-of-digital-identity-odi/> .
dio-odi:TrustDimension a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Trust"@en ;
  dcterms:isPartOf dio-odi:K6 ;
  skos:definition "A context- and task-sensitive evaluative state used as a functional analytical label; it need not imply human psychology in machine observers."@en ;
  skos:related dio-odi:RelationshipDimension ;
  dcterms:source <https://danielberanek.cz/manifesto-of-digital-identity-optimization-dio-and-ontology-of-digital-identity-odi/>, <https://doi.org/10.5281/zenodo.23226205> .
dio-odi:RelationshipDimension a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Relationship"@en ;
  dcterms:isPartOf dio-odi:K6 ;
  skos:definition "A persistent, historically sedimented relation between an observer and an entity that can shape future processing or encounters."@en ;
  skos:related dio-odi:TrustDimension ;
  dcterms:source <https://danielberanek.cz/manifesto-of-digital-identity-optimization-dio-and-ontology-of-digital-identity-odi/>, <https://doi.org/10.5281/zenodo.23226205> .
dio-odi:ReconstructionDimension a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Reconstruction"@en ;
  dcterms:isPartOf dio-odi:K6 ;
  skos:related dio-odi:ReconstructionMechanism ;
  dcterms:source <https://danielberanek.cz/manifesto-of-digital-identity-optimization-dio-and-ontology-of-digital-identity-odi/>, <https://doi.org/10.5281/zenodo.23226205> .

dio-odi:ReferentialContinuity a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Referential Continuity"@en ;
  skos:definition "Continuity by which an entity can change over time while remaining the same referent for analytical purposes."@en ;
  skos:related dio-odi:IdentityPreservingConstraint, dio-odi:TemporalDiscontinuity ;
  dcterms:source <https://doi.org/10.5281/zenodo.23226205> .

dio-odi:DistributedRepresentationalState a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Distributed Digital Representational State"@en ;
  skos:definition "The observable distributed digital state through which an entity is represented, including content, attributes, metadata, identifiers, provenance, availability, and relations among representations."@en ;
  skos:related dio-odi:ReconstructionMechanism ;
  dcterms:source <https://doi.org/10.5281/zenodo.23226205> .

dio-odi:Observer a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Observer"@en ;
  skos:definition "A human or machine observer together with the mechanism through which it reads or processes representations."@en ;
  skos:related dio-odi:ObservationDomain, dio-odi:ReconstructionMechanism ;
  dcterms:source <https://doi.org/10.5281/zenodo.23226205> .

dio-odi:ObservationDomain a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Observation Domain"@en ;
  skos:definition "A bounded set of observational situations against which a specific analysis or optimization is evaluated."@en ;
  skos:related dio-odi:Observer ;
  dcterms:source <https://doi.org/10.5281/zenodo.23226205> .

dio-odi:ReconstructionMechanism a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Reconstruction Mechanism"@en ;
  skos:definition "A mechanism through which changes in an entity's representational state can alter its reconstruction under sufficiently comparable observation conditions."@en ;
  skos:related dio-odi:DIOProblem, dio-odi:DIOIntervention, dio-odi:DistributedRepresentationalState, dio-odi:Observer ;
  dcterms:source <https://doi.org/10.5281/zenodo.23226205> .

dio-odi:DIOProblem a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "DIO Problem"@en ;
  skos:definition "An inadequacy of reconstruction, continuity, or robustness relative to a legitimate objective within a defined observation domain."@en ;
  skos:related dio-odi:ReconstructionMechanism, dio-odi:DIOIntervention ;
  dcterms:source <https://doi.org/10.5281/zenodo.23226205> .

dio-odi:DIOIntervention a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "DIO Intervention"@en ;
  skos:definition "An intentional and systematic change to the distributed representational state or relations among representations undertaken to address a DIO problem."@en ;
  skos:related dio-odi:DIOProblem, dio-odi:ReconstructionMechanism ;
  dcterms:source <https://doi.org/10.5281/zenodo.23226205> .

dio-odi:IdentityPreservingConstraint a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Identity-Preserving Constraint"@en ;
  skos:definition "A condition whose preservation allows differing reconstructions or transformations to remain legitimately anchored to the same referentially continuous entity."@en ;
  skos:historyNote "Retained as a historical vocabulary entry for traceability to the vocabulary state preceding v0.2.0. The collective term Identity-Preserving Constraints is introduced separately in v0.2.0. This note records editorial history only and does not assert a semantic relation between the two concepts."@en ;
  skos:related dio-odi:ReferentialContinuity, dio-odi:EssentialVector ;
  dcterms:source <https://doi.org/10.5281/zenodo.23226205> .

dio-odi:EssentialVector a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Essential Vector"@en ;
  skos:definition "The minimal relevant core of identity-preserving constraints; the term does not imply a metaphysical essence or necessarily a numerical vector space."@en ;
  skos:related dio-odi:IdentityPreservingConstraint ;
  dcterms:source <https://doi.org/10.5281/zenodo.21610934>, <https://doi.org/10.5281/zenodo.23226205> .

dio-odi:IdentityPreservingConstraints a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Identity-Preserving Constraints"@en ;
  skos:definition "A domain-configured set of conditions evaluated to determine whether differing reconstructions or transformations may legitimately be attributed to the same referentially continuous entity."@en ;
  skos:scopeNote "The applicable set may vary by entity class, operational domain, and observation context; this concept does not specify a universal or context-free constraint inventory."@en ;
  skos:related dio-odi:ReferentialContinuity, dio-odi:EssentialVector ;
  dcterms:source <https://doi.org/10.5281/zenodo.23226205>, <https://doi.org/10.5281/zenodo.23580733> .

dio-odi:IdentityPreservingVariation a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Identity-Preserving Variation"@en ;
  skos:definition "Legitimate contextual variation among reconstructions that preserves referential continuity and compatibility rather than requiring uniformity."@en ;
  skos:related dio-odi:ReferentialContinuity, dio-odi:SemanticFragmentation ;
  dcterms:source <https://doi.org/10.5281/zenodo.23226205> .

dio-odi:ReconstructionFailureMode a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ;
  skos:topConceptOf dio-odi:ReferenceVocabulary ;
  skos:prefLabel "Reconstruction Failure Mode"@en ;
  skos:definition "A realized, analytically distinguishable way in which identity reconstruction fails."@en ;
  skos:narrower dio-odi:ReferentialReconstructionFailure, dio-odi:SemanticCoherenceFailure, dio-odi:TemporalReconstructionFailure, dio-odi:ContextualAdequacyFailure ;
  skos:scopeNote "The taxonomy is non-exclusive and multi-level; a single case may instantiate multiple failure modes."@en ;
  dcterms:source <https://doi.org/10.5281/zenodo.23226205>, <https://doi.org/10.5281/zenodo.23269323> .

dio-odi:ReferentialReconstructionFailure a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Referential Reconstruction Failure"@en ;
  skos:definition "A reconstruction failure concerning the identity assignment of an intended referent."@en ;
  skos:broader dio-odi:ReconstructionFailureMode ;
  skos:narrower dio-odi:EntitySubstitution, dio-odi:MergeFailure, dio-odi:SplitFailure, dio-odi:EntityOmission ;
  dcterms:source <https://doi.org/10.5281/zenodo.23269323> .

dio-odi:EntitySubstitution a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Entity Substitution"@en ;
  skos:definition "A failure in which an intended referent is reconstructed as another distinct referent."@en ;
  skos:broader dio-odi:ReferentialReconstructionFailure ;
  skos:scopeNote "This concept does not redefine Identity Collapse and is not asserted to be its canonical form."@en ;
  skos:related dio-odi:IdentityCollapse ;
  dcterms:source <https://doi.org/10.5281/zenodo.23269323> .

dio-odi:MergeFailure a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Merge Failure"@en ;
  skos:definition "A failure in which two or more distinct referents are reconstructed as a single referential identity."@en ;
  skos:broader dio-odi:ReferentialReconstructionFailure ;
  dcterms:source <https://doi.org/10.5281/zenodo.23226205> .

dio-odi:SplitFailure a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Split Failure"@en ;
  skos:definition "A failure in which one referentially continuous entity is reconstructed as two or more distinct referential identities."@en ;
  skos:broader dio-odi:ReferentialReconstructionFailure ;
  skos:related dio-odi:SemanticFragmentation ;
  dcterms:source <https://doi.org/10.5281/zenodo.23226205> .

dio-odi:EntityOmission a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Entity Omission"@en ;
  skos:definition "A failure in which sufficient representational grounds are available to an observer within the relevant observation domain, yet no relevant reconstruction of the entity is produced."@en ;
  skos:broader dio-odi:ReferentialReconstructionFailure ;
  skos:scopeNote "Does not include cases where relevant representations were unavailable, unacquired, uncrawled, unindexed, or unretrieved."@en ;
  dcterms:source <https://doi.org/10.5281/zenodo.23269323> .

dio-odi:SemanticCoherenceFailure a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Semantic Coherence Failure"@en ;
  skos:broader dio-odi:ReconstructionFailureMode ;
  skos:narrower dio-odi:SemanticFragmentation ;
  dcterms:source <https://doi.org/10.5281/zenodo.23269323> .

dio-odi:SemanticFragmentation a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Semantic Fragmentation"@en ;
  skos:definition "Loss of identity-preserving coherence among distributed reconstructions of the same referentially continuous entity while referential unity may remain preserved."@en ;
  skos:broader dio-odi:SemanticCoherenceFailure ;
  skos:related dio-odi:SplitFailure, dio-odi:IdentityPreservingVariation ;
  dcterms:source <https://doi.org/10.5281/zenodo.22257504>, <https://doi.org/10.5281/zenodo.23226205>, <https://doi.org/10.5281/zenodo.23269323> .

dio-odi:TemporalReconstructionFailure a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Temporal Reconstruction Failure"@en ;
  skos:broader dio-odi:ReconstructionFailureMode ;
  skos:narrower dio-odi:TemporalDiscontinuity, dio-odi:TemporalMisalignment ;
  dcterms:source <https://doi.org/10.5281/zenodo.23269323> .

dio-odi:TemporalDiscontinuity a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Temporal Discontinuity"@en ;
  skos:definition "Failure to preserve referential continuity across legitimate transformations of the same entity over time."@en ;
  skos:broader dio-odi:TemporalReconstructionFailure ;
  skos:related dio-odi:ReferentialContinuity, dio-odi:TemporalMisalignment ;
  dcterms:source <https://doi.org/10.5281/zenodo.22257504>, <https://doi.org/10.5281/zenodo.23226205>, <https://doi.org/10.5281/zenodo.23269323> .

dio-odi:TemporalMisalignment a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Temporal Misalignment"@en ;
  skos:definition "A failure in which the correct referent is identified but the reconstructed state is temporally inappropriate to the observational situation."@en ;
  skos:broader dio-odi:TemporalReconstructionFailure ;
  skos:related dio-odi:TemporalDiscontinuity ;
  dcterms:source <https://doi.org/10.5281/zenodo.23226205>, <https://doi.org/10.5281/zenodo.23269323> .

dio-odi:ContextualAdequacyFailure a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Contextual Adequacy Failure"@en ;
  skos:broader dio-odi:ReconstructionFailureMode ;
  skos:narrower dio-odi:ContextualDisplacement ;
  dcterms:source <https://doi.org/10.5281/zenodo.23269323> .

dio-odi:ContextualDisplacement a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Contextual Displacement"@en ;
  skos:definition "A failure in which a factually supportable reconstruction is inadequate to the relevant observational context because another legitimate aspect of identity displaces the aspect currently relevant."@en ;
  skos:broader dio-odi:ContextualAdequacyFailure ;
  dcterms:source <https://doi.org/10.5281/zenodo.23226205>, <https://doi.org/10.5281/zenodo.23269323> .

dio-odi:IdentityCollapse a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Identity Collapse"@en ;
  skos:definition "A phenomenon-level concept concerning impairment of the identity function of a particular entity, retained in the sense established in The Crisis of Entity Resolution in Heterogeneous AI Environments."@en ;
  skos:scopeNote "Not classified as a branch of the current Reconstruction Failure Mode hierarchy. The vocabulary does not assert whether individual failure modes cause, constitute, exhaust, or are required for Identity Collapse."@en ;
  dcterms:source <https://doi.org/10.5281/zenodo.22257504>, <https://doi.org/10.5281/zenodo.23269323> .

dio-odi:SemanticVulnerability a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Semantic Vulnerability"@en ;
  skos:definition "A robustness-related property describing susceptibility of identity reconstruction to destabilization or disproportionate change under perturbations of the representational environment."@en ;
  skos:scopeNote "Not a Reconstruction Failure Mode."@en ;
  skos:related dio-odi:SemanticRobustness, dio-odi:ReconstructionCapture ;
  dcterms:source <https://doi.org/10.5281/zenodo.22257504>, <https://doi.org/10.5281/zenodo.23226205>, <https://doi.org/10.5281/zenodo.23269323> .

dio-odi:SemanticRobustness a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Semantic Robustness"@en ;
  skos:definition "The conceptual counterpart of Semantic Vulnerability: robustness of identity reconstruction under perturbations of the representational environment."@en ;
  skos:related dio-odi:SemanticVulnerability ;
  dcterms:source <https://doi.org/10.5281/zenodo.23269323> .

dio-odi:ReconstructionCapture a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Reconstruction Capture"@en ;
  skos:definition "A concept used for cases in which a small subset of representations has disproportionate influence over the resulting reconstruction."@en ;
  skos:related dio-odi:SemanticVulnerability ;
  skos:scopeNote "Included because it is present in MVDIO; v0.1 does not further formalize its relationship to Semantic Vulnerability."@en ;
  dcterms:source <https://doi.org/10.5281/zenodo.23226205> .

dio-odi:EntityResolutionAnomaly a skos:Concept ;
  skos:inScheme dio-odi:ReferenceVocabulary ; skos:prefLabel "Entity Resolution Anomaly"@en ;
  skos:historyNote "Historical grouping introduced in The Crisis of Entity Resolution in Heterogeneous AI Environments. Later work differentiates concepts previously grouped together into distinct analytical levels; this vocabulary therefore does not use Entity Resolution Anomaly as the current parent category for the revised concepts."@en ;
  dcterms:source <https://doi.org/10.5281/zenodo.22257504>, <https://doi.org/10.5281/zenodo.23269323> .

